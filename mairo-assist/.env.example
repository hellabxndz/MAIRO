# Mairo Assist — environment variables.
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional at boot: features explain what's missing
# instead of pretending to work.

# --- Supabase (required for accounts and the dashboard) ----------------------
# Project Settings → API. The publishable key is safe for the browser; RLS
# protects the data. (Legacy projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY.)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server-only. Bypasses row-level security; used for audit logs, rate limits,
# webhooks and background jobs. (Legacy name: SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=""

# Show "Continue with Google" on sign-in/sign-up. Set to "true" only after the
# Google provider is enabled in Supabase (Authentication → Providers → Google).
AUTH_GOOGLE_ENABLED="false"

# --- This deployment ------------------------------------------------------------
# Public origin used in email links and invitations. On Vercel it falls back to
# the production domain automatically. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# --- Encryption (required before connecting Shopify) --------------------------
# 32 random bytes, base64. Encrypts store access tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes stored tokens unreadable (stores must reconnect).
ENCRYPTION_KEY=""

# --- OpenAI (Phase 2: AI conversations) -----------------------------------------
OPENAI_API_KEY=""
# Pick a current model from https://platform.openai.com/docs/models that
# supports function calling in the Responses API.
OPENAI_MODEL=""
# USD per 1M tokens for the model above, from OpenAI's pricing page. Used for
# per-business cost estimates; leave empty and estimates show as unavailable.
OPENAI_PRICE_INPUT_PER_MTOK=""
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=""
OPENAI_PRICE_OUTPUT_PER_MTOK=""
# Optional: point the SDK at a different OpenAI-compatible endpoint (tests use this).
OPENAI_BASE_URL=""

# --- Shopify (Phase 3) ----------------------------------------------------------
# From your app in the Shopify Partner Dashboard / Dev Dashboard.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Admin GraphQL API version. Defaults to 2026-07 (latest stable when written).
SHOPIFY_API_VERSION=""
# Least-privilege, read-only scopes (this is the default when left empty).
SHOPIFY_SCOPES="read_products,read_inventory,read_orders"
# Set to "approved" only after Shopify approves the app for protected customer
# data. Adds read_customers and syncs names/emails on orders.
SHOPIFY_CUSTOMER_DATA=""
# TESTS ONLY: send Shopify requests to a local fake store. Refused when
# VERCEL_ENV=production. Never set this on a real deployment.
# SHOPIFY_TEST_API_BASE_URL=""

# --- Billing ----------------------------------------------------------------------
# Every business starts on the Free plan (100 AI responses a month, never
# charged). Paid plans are sold through Stripe Checkout; they can only be
# bought once ALL of the values below are set. Use test-mode keys first.
STRIPE_SECRET_KEY=""
# From Stripe → Developers → Webhooks → your endpoint
# (https://<your-app>/api/webhooks/stripe). Keep it secret.
STRIPE_WEBHOOK_SECRET=""
# Price IDs (price_...) of the monthly recurring prices you create in Stripe.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
# TESTS ONLY: send Stripe calls to a local fake. Ignored when VERCEL_ENV=production.
# STRIPE_TEST_API_BASE_URL=""
# Optional overrides of plan prices, in cents (defaults in src/lib/billing/plans.ts).
# PLAN_PRICE_STARTER_CENTS=14900
# PLAN_PRICE_GROWTH_CENTS=29900
# PLAN_PRICE_PRO_CENTS=49900
# PLAN_PRICE_ENTERPRISE_CENTS=99900

# --- Operations -----------------------------------------------------------------
# Protects /api/cron/jobs (job queue + conversation retention, daily via
# vercel.json). Vercel sends it automatically once set in the project.
CRON_SECRET=""
# Where Enterprise "Talk to us" buttons send email (falls back to sign-up).
NEXT_PUBLIC_SALES_EMAIL=""
