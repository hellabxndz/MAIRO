# --- Database (Neon Postgres recommended: https://neon.tech) ---
# The pooled connection string, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional: a direct (non-pooled) connection string, used only for running
# migrations. On Neon, toggle "Pooled connection" off in Connection Details
# to get this one. If omitted, migrations fall back to DATABASE_URL, which
# works for a plain (non-Neon) Postgres but can fail against Neon's pooler.
DIRECT_URL=""

# --- Auth (Auth.js / NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Meta (Facebook) Marketing API ---
# From your Meta App at https://developers.facebook.com/apps
META_APP_ID=""
META_APP_SECRET=""
# Optional. On Vercel this is derived automatically from the project's
# production domain, so leave it unset there. Set it only to override that
# (e.g. a custom domain that differs from the Vercel one). Whatever the app
# resolves it to must be registered verbatim under Valid OAuth Redirect URIs
# on the Meta App — see /aios/setup in the running app, which prints it.
META_REDIRECT_URI=""

# --- AI agents (Claude) ---
ANTHROPIC_API_KEY=""

# Encrypts the Meta access tokens before they are stored.
#
# These tokens are credentials for your clients' ad accounts — anyone holding
# one can create campaigns and spend that business's money. Without this key
# they sit in the database as plain text, so a leaked backup or a
# misconfigured replica hands them over intact.
#
# Generate one with:  openssl rand -base64 32
#
# Losing it means the stored connections cannot be read and every client has
# to reconnect, so keep a copy somewhere safe. Tokens written before it was
# set keep working and are encrypted the next time they are saved.
TOKEN_ENCRYPTION_KEY=""

# --- Owner recovery (leave unset normally) ---
# Set this temporarily to reopen /setup as a recovery page when an OWNER
# account exists but nobody can sign in as one. Visit /setup?token=<value>,
# reset the account, then DELETE this variable — while it is set, anyone
# holding the token can take over the owner account.
OWNER_SETUP_TOKEN=""

# --- Ad picture generation (Google Gemini image model) ---
# Claude reads pictures but cannot make them, so pictures come from Google.
# Free tier exists for testing; note that free tiers generally permit the
# provider to train on your data — use a paid key before real customer photos.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional override if Google renames the image model.
IMAGE_MODEL=""
