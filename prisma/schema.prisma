// MyRo (MAIRO) — schema for the ad-management SaaS platform.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth / accounts -------------------------------------------------------

enum UserRole {
  OWNER // MyRo staff — sees the AIOS dashboard and every client org
  CLIENT // a business owner using the app to run their ads
  FREELANCER // runs ads for several businesses from one login
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  /// Null for someone who only ever signed in with Google. The credentials
  /// provider refuses an account without one, so it can't be signed into with
  /// an empty password.
  passwordHash    String?
  /// The Google account's stable id (the OIDC `sub`), set the first time this
  /// person continues with Google. Matched before email, so a later change of
  /// address at Google still finds the same MAIRO account.
  googleId        String?       @unique
  name            String?
  role            UserRole      @default(CLIENT)
  /// When this person finished — or skipped — the walkthrough.
  ///
  /// On the account rather than in the browser, which is the whole point. It
  /// used to live in localStorage, so the tour came back every time somebody
  /// signed in from a different device, a private window, or after clearing
  /// site data — and it was shared between two accounts used on one browser,
  /// so the second person to sign in never got shown it at all.
  tourCompletedAt DateTime?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  organizationId  String?
  agentThreads    AgentThread[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// --- Client business -------------------------------------------------------

enum AdGoal {
  LEADS
  SALES
  AWARENESS
  TRAFFIC
  APP_PROMOTION
  /// Messages, or likes, comments and shares on the ad. Meta only.
  ENGAGEMENT
}

enum PlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  COMPLETE
}

/// How much MAIRO may do without asking.
///
/// The meanings, and the inventory of exactly what each one permits, live in
/// src/lib/automation/levels.ts — not here and not in the UI, so there is one
/// answer to "what is MAIRO allowed to do" rather than three that drift.
/// What a notification is about. Drives the icon, the tone and which SMS
/// preference governs it — the copy itself lives on the row, because it is
/// written from that account's own figures.
enum NotificationKind {
  CAMPAIGN_LIVE
  NEEDS_ATTENTION
  BUDGET_OPPORTUNITY
  CREATIVE_FATIGUE
  CREATIVES_READY
  MONTHLY_REPORT
  WEEKLY_REPORT
  PAYMENT_ISSUE
  ACCOUNT_DISCONNECTED
  MAIRO_ACTED
  /// The Performance Coach found something worth knowing.
  COACH_ALERT
  /// The MAIRO subscription was cancelled or ended. Says what that means for
  /// the Meta campaigns still running, which it doesn't change.
  SUBSCRIPTION_CHANGE
}

enum NotificationSeverity {
  INFO
  OPPORTUNITY
  WARNING
}

enum AutomationLevel {
  /// MAIRO proposes, a person applies. Nothing moves on its own.
  MANUAL
  /// Reversible changes inside an existing budget happen automatically.
  ASSISTED
  /// Adds targeting and bids, still inside the customer's own ceilings.
  AUTOPILOT
}

enum SubscriptionTier {
  NONE
  STARTER
  GROWTH
  SCALE
  // Freelancer tiers. Priced by how many client businesses can be run at once
  // rather than by how much advertising one business does, because that is the
  // thing that actually scales for someone doing this for a living.
  STUDIO
  AGENCY
}

/// What an Organization *is*.
///
/// BUSINESS is every organization that existed before freelancers: a company
/// running its own advertising. WORKSPACE is a freelancer's own account — it
/// never runs ads itself, it exists to own the client businesses beneath it and
/// to hold the subscription that pays for them.
enum OrganizationKind {
  BUSINESS
  WORKSPACE
}

model Organization {
  id               String           @id @default(cuid())
  name             String
  website          String?
  industry         String?
  timezone         String           @default("America/New_York")
  subscriptionTier SubscriptionTier @default(NONE)

  kind OrganizationKind @default(BUSINESS)

  /// What this business wants a click to do, answered at signup.
  ///
  /// The default every campaign starts from, not a rule — a campaign can send
  /// people somewhere else without changing what the business normally does.
  defaultDestination    AdDestination  @default(WEBSITE)
  /// The number a tap-to-call ad rings, in E.164 (+15551234567).
  phone                 String?
  /// Which inbox a message ad opens, when defaultDestination is DIRECT_MESSAGE.
  ///
  /// Stored for the same reason phone is: it is the detail that answer needs to
  /// be usable. Without it, signup accepted "they message me" and then every
  /// campaign silently assumed Messenger — which is wrong for the businesses
  /// whose customers are on WhatsApp, and wrong quietly, because the ad still
  /// launches and just opens the wrong place.
  defaultMessageChannel MessageChannel @default(MESSENGER)

  /// What this business calls its assistant.
  ///
  /// Defaults to Alex and is theirs to change. It is the same assistant either
  /// way — the name is on the organization rather than in the model's prompt
  /// identity, so renaming it does not change what it knows or how it behaves,
  /// only what it is called on screen and how it signs a text message.
  assistantName String @default("Alex")

  /// Where the pictures and words in a sales ad come from.
  ///
  /// Asked after payment and only of businesses selling online, because it is
  /// the only goal where the answer differs: a plumber has no catalogue and no
  /// post worth boosting, while a shop usually has both and would rather run
  /// the post that already did well than have one written from scratch.
  salesAdSource    SalesAdSource @default(MAIRO_CREATES)
  /// The Page post to run as an ad, as Meta's own {page-id}_{post-id}.
  boostPostId      String?
  /// The Meta product catalogue MAIRO fills from their website, once made.
  productCatalogId String?
  /// When MAIRO last read their shop and rebuilt the product list.
  catalogScannedAt DateTime?

  /// Stops MAIRO putting campaigns live on its own.
  ///
  /// Off by default, because running the ads is what the customer is paying
  /// for and making them press a final button is the thing MAIRO exists to
  /// remove. On is the escape hatch for somebody who wants to look first —
  /// and it only ever holds the switch-on, never the building.
  autoLaunchHeld Boolean   @default(false)
  /// When MAIRO last took a campaign live by itself. A record, and what stops
  /// the dashboard reporting it as a surprise.
  autoLaunchedAt DateTime?

  /// A business that signed itself up through the free plan. For these,
  /// building, changing budgets, launching and creative generation always
  /// need a paid (or trialing) subscription, whatever BILLING_ENFORCED says.
  /// Older accounts, and the Meta App Review account, follow BILLING_ENFORCED.
  paymentRequired        Boolean   @default(false)
  /// Answers on the setup screens before they're finished (OnboardingDraft),
  /// so leaving halfway — or a failed save — loses nothing. Cleared once the
  /// intake is saved.
  onboardingDraft        Json?
  /// Whether a payment has ever gone through. A subscription that ends or
  /// fails before this is true never paid — its ads are stopped.
  hasPaid                Boolean   @default(false)
  /// When MAIRO stopped everything because the trial ended unpaid (or was
  /// cancelled before any payment), and why. Cleared by a new subscription.
  executionStoppedAt     DateTime?
  executionStoppedReason String?

  /// Scale: the business said yes to "Let MAIRO post on your Instagram feed?".
  /// Nothing is planned for Instagram before this. Every post still needs
  /// its own approval after seeing the preview.
  instagramOptInAt    DateTime?
  /// They answered "Not now" — asked again later, never nagged.
  instagramDeclinedAt DateTime?
  /// Scale: yes to "Let MAIRO post on your Facebook Page?". Needs the
  /// pages_manage_posts permission, asked for only when they say yes.
  facebookOptInAt     DateTime?
  facebookDeclinedAt  DateTime?

  // A freelancer's clients hang off their workspace.
  //
  // Deliberately a parent link rather than a User-to-Organization join table.
  // Every query in the app is already scoped by organizationId, and a join
  // table would mean revisiting all of them; a parent link leaves those queries
  // untouched and makes "can this user reach this organization?" a single
  // comparison — it is your own organization, or its parent is.
  //
  // Cascade: deleting a freelancer's workspace deletes the client businesses
  // inside it. That is the right default because the workspace is the account
  // and the clients only exist within it, but it does mean the delete-account
  // path is more destructive for a freelancer than for a business owner.
  parent   Organization?  @relation("WorkspaceClients", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  clients  Organization[] @relation("WorkspaceClients")

  // Billing. Stripe is the source of truth for what someone is paying for —
  // these columns are a local copy kept in step by the webhook, so a page load
  // never has to call Stripe to know what plan a client is on.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Mirrors Stripe's subscription status: active, trialing, past_due,
  // canceled, incomplete... Stored as text rather than an enum because Stripe
  // adds statuses and a migration should not be needed to receive one.
  subscriptionStatus   String?
  // When the paid period ends. A cancelled subscription keeps working until
  // this passes, which is what the client paid for.
  currentPeriodEnd     DateTime?
  /// When Stripe will end the subscription because the owner cancelled it
  /// (cancel at period end). Null while it renews. The plan stays active until
  /// then; MAIRO-managed Meta campaigns are a separate question the billing
  /// page answers on its own.
  subscriptionCancelAt DateTime?

  users            User[]
  intake           OnboardingIntake?
  monthlyPlans     MonthlyPlan[]
  metaAdAccount    MetaAdAccount?
  campaigns        Campaign[]
  creativeRequests CreativeRequest[]
  agentThreads     AgentThread[]

  // Multi-platform advertising.
  platformConnections  PlatformConnection[]
  mairoCampaigns       MairoCampaign[]
  platformCreatives    PlatformCreative[]
  autoOptimizeSettings AutoOptimizeSettings?
  managedSetups        ManagedAccountSetup[]
  tiktokPosts          TikTokPost[]
  instagramPosts       InstagramPost[]
  socialStrategy       SocialStrategy?
  socialPromotions     SocialPromotion[]
  missions             MarketingMission[]
  missionNotes         MissionNote[]
  platformCapabilities PlatformAccountCapability[]
  platformOptIns       PlatformFeatureOptIn[]
  tiktokCreator        TikTokCreatorConnection?
  trackingPixels       TrackingPixel[]
  conversionEvents     ConversionEvent[]
  storeIngest          StoreIngest?
  trackingProfile      TrackingProfile?
  gtmConnection        GtmConnection?
  leadForms            LeadForm[]
  notifications        Notification[]
  smsPreference        SmsPreference?
  leads                Lead[]
  products             Product[]
  creativeStudioAssets CreativeStudioAsset[]
  creativeCreditLedger CreativeCreditLedger[]
  spendProtection      SpendProtection?
  protectionEvents     ProtectionEvent[]
  campaignDrafts       CampaignDraft[]
  businessBrain        BusinessBrain?
  decisions            MairoDecision[]
  activities           MairoActivity[]
  insights             MairoInsight[]
  weeklyReports        WeeklyReport[]
  reportSettings       ReportSettings?
  learnings            MairoLearning[]
  strategyPlan         StrategyPlan?
  intelligenceReport   IntelligenceReport?
  profitSettings       ProfitSettings?

  /// When Mairo Decisions last looked at this account's campaigns, so a page
  /// load doesn't ask the ad networks again every time.
  decisionsCheckedAt DateTime?
  /// How often the Morning Brief covers: yesterday (DAILY) or the last seven days (WEEKLY).
  briefFrequency     BriefFrequency @default(DAILY)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  brainEvents BrainEvent[]

  /// Customer success. What the business tells MAIRO about MAIRO, and what
  /// the MAIRO team recorded talking to them.
  feedback     CustomerFeedback[]
  supportNotes SupportNote[]
  /// One of the first businesses on MAIRO, looked after more closely.
  foundingCustomer Boolean   @default(false)
  foundingSince    DateTime?
  /// The business agreed its results may be shared in an anonymized case
  /// study. Null means no — never assumed, and withdrawable at any time.
  caseStudyConsentAt DateTime?
  /// Last time anyone from the business opened the dashboard (to the hour).
  lastActiveAt DateTime?
  /// When the subscription ended, for retention. Cleared by a new one.
  canceledAt   DateTime?

  /// The MAIRO AI Team's work log for this business.
  agentRuns AgentRun[]
  coachFindings CoachFinding[]
  /// Notification preferences. Problems that stop ads are always shown;
  /// these switch off the optional kinds.
  notifyOpportunities Boolean @default(true)
  notifyReports       Boolean @default(true)
  /// Performance Coach alerts: slower follow-up, rising cost per good lead,
  /// tracking that stopped, lead quality slipping. Optional, like the above.
  notifyCoachAlerts   Boolean @default(true)
  /// The business's own names for its lead stages (JSON: stage → label), e.g.
  /// "Inspection booked" for an appointment. Null uses MAIRO's defaults.
  leadStagesJson      String? @db.Text
}

/// Where a business wants MAIRO to text them, and proof they asked for it.
///
/// A separate model rather than three columns on Organization, because consent
/// is an event with a time on it, not a flag. Regulators in both the US and the
/// UK ask the same question after the fact — when did this person agree, and
/// what did they agree to — and a boolean cannot answer it.
///
/// Nothing here sends anything on its own. src/lib/sms/send.ts refuses without
/// a verified number, live consent, and no opt-out, and refuses again if no
/// provider is configured.
model SmsPreference {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// E.164, as +15551234567. Stored only once a code sent to it came back.
  phone String

  /// When a code sent to this number was entered correctly. Null means the
  /// number is claimed but unproven, and nothing is ever sent to it.
  verifiedAt      DateTime?
  /// The code most recently sent, and when it stops being accepted.
  verifyCode      String?
  verifyExpiresAt DateTime?

  /// When this person agreed to be texted, and the exact wording they agreed
  /// to. The wording is stored because it changes over time and consent is to
  /// what was on the screen that day, not to whatever the screen says now.
  consentAt   DateTime?
  consentText String?   @db.Text

  /// When they stopped it — from the settings screen or by replying STOP.
  /// Set rather than deleted, so a number that opted out cannot be re-added
  /// quietly by anyone who can reach the form.
  optedOutAt DateTime?

  // What they actually want to hear about. All off by default: somebody who
  // turns texting on has not thereby asked for everything.
  onCampaignLive   Boolean @default(true)
  onNeedsAttention Boolean @default(true)
  onWeeklySummary  Boolean @default(false)
  onBudgetChange   Boolean @default(false)

  lastSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Something worth telling the business about, written down once.
///
/// The rule this model exists to enforce is that a notification is a fact, not
/// a feeling. Every row is created from figures that were true at the time and
/// carries them in `evidenceJson`, so "your cost per purchase went up" can
/// still be checked a week later when the numbers have moved on.
///
/// `dedupeKey` is what stops it becoming spam. A detector that runs daily and
/// finds the same fatigued creative every day would otherwise produce a
/// notification a day about one problem; the key is unique per organization,
/// so the second run updates nothing and creates nothing.
model Notification {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  kind     NotificationKind
  severity NotificationSeverity @default(INFO)

  /// One line, in the customer's language.
  title String
  /// The detail, already written from this account's own numbers.
  body  String @db.Text

  /// Where to go about it, when there is somewhere to go.
  actionLabel String?
  actionHref  String?

  /// What it is about, for linking and for clearing it when that thing changes.
  mairoCampaignId String?

  /// The figures behind it, so it can be explained rather than just asserted.
  evidenceJson String? @db.Text

  /// Unique per organization. Two runs of the same detector over the same
  /// situation produce the same key and therefore one row.
  dedupeKey String

  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

model OnboardingIntake {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  primaryGoal        AdGoal
  monthlyBudgetCents Int
  targetAudience     String?
  brandVoice         String?
  competitors        String?
  notes              String?
  /// What the business sells or offers, in its own words.
  offering           String?
  /// What makes it different from competitors.
  differentiator     String?
  /// The offer running now, if any, in their words ("20% off first visit").
  currentOffer       String?
  /// Where their customers are, in their words ("Austin, TX").
  customerLocation   String?

  completedAt DateTime @default(now())
}

model MonthlyPlan {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  month                String // e.g. "2026-09"
  status               PlanStatus @default(DRAFT)
  strategySummary      String     @db.Text // AI-generated narrative
  budgetAllocationJson String     @db.Text // JSON: { channel, percent, amountCents }[]
  keyMetrics           String?    @db.Text // JSON of target KPIs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, month])
}

// --- Meta integration --------------------------------------------------

enum MetaConnectionStatus {
  DISCONNECTED
  CONNECTED
  TOKEN_EXPIRED
  ERROR
}

model MetaAdAccount {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  metaAdAccountId String // act_xxxxxxxx
  metaBusinessId  String?
  pageId          String?
  /// The Page's name at the time it was chosen, so the dashboard can say which
  /// Page ads go out as without a Graph call on every render.
  ///
  /// A cached label, not a source of truth: a Page renamed on Facebook shows
  /// the old name here until the customer reopens the picker. That is the right
  /// trade — the id is what actually matters, and a stale word beats making
  /// every page load wait on Meta.
  pageName        String?
  accessToken     String               @db.Text // long-lived user/system token
  tokenExpiresAt  DateTime?
  status          MetaConnectionStatus @default(CONNECTED)

  campaigns Campaign[]

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Where a lead form actually lives.
///
/// HOSTED_PAGE is the page MAIRO writes and serves: it works today, needs no
/// permission from anybody, and costs a tap and a page load. META_NATIVE is
/// Meta's instant form, which opens inside Facebook or Instagram with the
/// person's name and contact details already filled in — materially better
/// conversion, and gated behind two App Review permissions this app does not
/// have yet.
enum LeadFormDelivery {
  HOSTED_PAGE
  META_NATIVE
}

/// Which inbox a click-to-message ad opens.
///
/// Three different products wearing one word. Messenger needs only the Page,
/// which MAIRO already has. Instagram needs an Instagram account linked to that
/// Page. WhatsApp needs a WhatsApp number connected to it. A business picking
/// the wrong one gets a refusal from Meta rather than a broken ad, which is why
/// this is asked rather than guessed.
enum MessageChannel {
  MESSENGER
  INSTAGRAM
  WHATSAPP
}

/// Where an ad sends the person who clicks it.
///
/// Not a style choice — Meta builds a different creative for each, and asking
/// the customer is the only way to know. A plumber wants the phone to ring; a
/// shop wants people on a product page. Guessing produced ads that sent buyers
/// to a homepage that does not sell anything, or no ad at all when the
/// business had no website to guess from.
enum AdDestination {
  /// A link. The business supplies the exact URL the click should land on.
  WEBSITE
  /// A tap-to-call button, wired to the business's own number through Meta.
  PHONE_CALL
  /// A form MAIRO hosts and wrote the questions for. The ad links to it.
  LEAD_FORM
  /// A conversation. The ad opens Messenger with the business's Page.
  DIRECT_MESSAGE
  /// Nowhere to go: the point is likes, comments and shares on the ad itself.
  POST_ENGAGEMENT
  /// The business's mobile app, in its app store.
  APP
}

/// Meta's special ad categories. Each restricts how the ad may be targeted.
enum SpecialAdCategory {
  HOUSING
  EMPLOYMENT
  FINANCIAL_PRODUCTS_SERVICES
  ISSUES_ELECTIONS_POLITICS
}

enum BudgetType {
  /// The same amount every day until it stops.
  DAILY
  /// One total for the whole run, spent by the end date.
  LIFETIME
}

/// A Create flow somebody started and hasn't finished, kept so they can come back.
model CampaignDraft {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  createdByUserId String?
  /// Which Create service it belongs to: meta, tiktok or multi.
  service         String
  /// A readable name for the list of drafts.
  label           String
  /// The screen they were on.
  step            String
  /// Every answer so far, exactly as the flow holds it.
  data            Json
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, updatedAt])
}

/// One thing a business sells, read off its own website.
///
/// MAIRO builds this list rather than asking the business to build a catalogue
/// in Meta Business Manager, because almost none of them have one and the ones
/// who do had it set up by somebody else. The shop already lists what it sells,
/// on a page it maintains; that is the catalogue.
model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// The shop's own id for it where the site gives one, else the product URL.
  /// The dedup key, so re-reading a shop updates rather than duplicates.
  externalId String

  title       String
  description String?
  /// Integer cents, like every other amount in this schema. Null when the page
  /// showed no price — a real state for "call for a quote", and not zero.
  priceCents  Int?
  /// What one unit costs the business, entered on Profit First. Null until they do.
  costCents   Int?
  currency    String  @default("USD")
  imageUrl    String?
  /// Where the product is bought. This is what the ad links to.
  url         String
  available   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, externalId])
  @@index([organizationId])
}

/// Where a sales ad's pictures and words come from.
///
/// Three genuinely different builds, not three settings. MAIRO_CREATES is the
/// pipeline that already exists: a picture generated, copy written, an ad
/// assembled. EXISTING_POST runs something the business already published, so
/// Meta is handed the post's own id and MAIRO writes nothing. CATALOG is
/// Meta's own catalogue ads, where Meta picks which product to show each
/// person — a different campaign shape again, and the one still to be built.
enum SalesAdSource {
  MAIRO_CREATES
  EXISTING_POST
  CATALOG
}

/// One campaign's answer to "how would you like to create your ad?".
enum CampaignAdSource {
  CREATIVE
  FACEBOOK_POST
  INSTAGRAM_POST
}

/// The placements the Create flow offers, in the customer's terms.
enum MetaPlacement {
  FACEBOOK_FEED
  INSTAGRAM_FEED
  STORIES
  REELS
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

/// A Meta campaign, from before MAIRO ran on more than one network.
///
/// Superseded by MairoCampaign + PlatformCampaign, which is what every code
/// path now reads and writes. The migration that introduced those backfilled a
/// parent and a META child for every row here and set mairoCampaignId, so
/// nothing was lost and nothing was moved twice.
///
/// The table stays because dropping it in the same deploy that introduced its
/// replacement would leave no way back if the backfill got something wrong.
/// Delete it in its own migration once the new path has a few weeks behind it.
model Campaign {
  id              String         @id @default(cuid())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  metaAdAccount   MetaAdAccount? @relation(fields: [metaAdAccountId], references: [id])
  metaAdAccountId String?

  /// Set by the multi-platform backfill: which MairoCampaign now owns this.
  mairoCampaign   MairoCampaign? @relation(fields: [mairoCampaignId], references: [id], onDelete: SetNull)
  mairoCampaignId String?

  metaCampaignId   String? // null until pushed live to Meta
  name             String
  objective        AdGoal
  status           CampaignStatus @default(DRAFT)
  dailyBudgetCents Int
  startDate        DateTime?
  endDate          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Creative production ----------------------------------------------

enum CreativeType {
  IMAGE
  VIDEO
  COPY
  CAROUSEL
}

enum CreativeStatus {
  REQUESTED
  IN_PROGRESS
  IN_REVIEW // a person needs to look — the automated check could not run
  BLOCKED // the automated safety/policy check refused it
  APPROVED
  DELIVERED
}

model CreativeRequest {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  month              String // e.g. "2026-09"
  type               CreativeType
  brief              String         @db.Text
  /// What this creative is for (Awareness, Trust, Conversion…) and why,
  /// from the business's active MAIRO mission.
  marketingObjective String?
  whyText            String?        @db.Text
  /// The Strategy Engine's brief (JSON): primary goal, marketing objective,
  /// audience, hook, message, CTA, format and the reason it was made.
  briefJson          String?        @db.Text
  status             CreativeStatus @default(REQUESTED)
  assetUrl           String?

  // An optional picture the client uploads as the starting point — a product
  // shot, a competitor's ad, a mood reference. Stored as a data URL because it
  // is downscaled to well under a megabyte in the browser before upload and
  // there is no object store configured yet; move this to blob storage before
  // volume makes it a problem.
  referenceImage String? @db.Text
  // What the Creative agent made of that picture and the brief together.
  aiConcept      String? @db.Text
  // Follow-up the client typed after reading the concept ("my shop is called
  // X", "make it about the sale"). Appended to, and fed back into the next
  // rewrite. Refining never costs another creative request.
  clientNotes    String? @db.Text

  // The automated safety and advertising-policy check that gates approval.
  // reviewNotes carries the refusal reason shown to the client when BLOCKED.
  reviewedAt     DateTime?
  reviewCategory String?
  reviewNotes    String?   @db.Text

  images         CreativeImage[]
  tiktokPosts    TikTokPost[]
  instagramPosts InstagramPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One pass of the picture the client is working on. Every time they say
// "make the background darker", the AI edits the current picture and a new
// row lands here.
//
// Superseded drafts are deleted as new ones arrive (see generateAdImageAction)
// so a long back-and-forth doesn't accumulate megabytes of dead images in the
// database — only the current draft and the finals the client chose survive.
model CreativeImage {
  id                String          @id @default(cuid())
  creativeRequest   CreativeRequest @relation(fields: [creativeRequestId], references: [id], onDelete: Cascade)
  creativeRequestId String

  version     Int
  // The generated picture, as a data URL. Same reasoning as
  // CreativeRequest.referenceImage: no object store is configured yet, and
  // this is the first thing to move to blob storage when one is.
  imageData   String  @db.Text
  // What the client typed to get this version. Null on the first one, which
  // comes from the concept rather than an instruction.
  instruction String? @db.Text
  // Chosen to actually run in the campaign. Capped per request in code.
  isFinal     Boolean @default(false)

  // The safety check that runs when a picture is chosen as final, since that
  // is the point at which it would really be used in an ad.
  reviewedAt  DateTime?
  reviewNotes String?   @db.Text

  createdAt DateTime @default(now())

  @@unique([creativeRequestId, version])
  @@index([creativeRequestId])
}

// --- AI agents -----------------------------------------------------------

enum AgentType {
  STRATEGIST
  CREATIVE
  SUPPORT
  OWNER_COPILOT
}

model AgentThread {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String

  agentType AgentType
  title     String?
  messages  AgentMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AgentMessage {
  id       String      @id @default(cuid())
  thread   AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String

  role    MessageRole
  content String      @db.Text

  createdAt DateTime @default(now())
}

// --- Multi-platform advertising -------------------------------------------
//
// Everything below this line exists so MAIRO can run a campaign on more than
// one advertising network while the customer still feels like they made one
// campaign. The shape is deliberately not "Meta, plus TikTok bolted on": it is
// a parent the customer owns and a child per network, so adding Google or
// Snapchat later is a new enum value and a new adapter rather than a schema
// change.
//
// A note on how this landed, because it constrains the design. `vercel-build`
// runs `prisma migrate deploy`, so any migration here runs against the live
// database on the next deploy. Everything in this section is therefore purely
// additive — new tables, new enum values, one new nullable column on Campaign.
// Nothing is dropped or rewritten. The old Campaign table is backfilled into
// the new structure and then left alone as a safety net; dropping it is a
// separate migration to make once the new path has run in production for a
// while.

/// The networks MAIRO can advertise on.
///
/// Values are added here before the adapter exists — `isImplemented` in
/// src/lib/ad-platforms/registry.ts is what decides whether a platform can
/// actually be chosen. That split is on purpose: it means a half-finished
/// platform can be developed behind a flag without a migration to turn it on.
enum AdPlatform {
  META
  TIKTOK
  GOOGLE
  SNAPCHAT
  PINTEREST
  LINKEDIN
}

enum PlatformConnectionStatus {
  DISCONNECTED
  CONNECTED
  TOKEN_EXPIRED
  ERROR
}

/// One organization's authorization to spend on one network.
///
/// The generic replacement for MetaAdAccount. Meta still reads its own table —
/// it works, it is in production, and moving it is a migration with no user
/// visible benefit — but every network added from TikTok onwards lives here,
/// and src/lib/ad-platforms/connections.ts presents both through one interface
/// so nothing above that layer knows the difference.
///
/// Tokens are ciphertext in this table. Nothing outside connections.ts may
/// read these two columns; see the note there.
model PlatformConnection {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  platform       AdPlatform

  /// The network's own id for the advertising account — advertiser_id on
  /// TikTok, act_xxx on Meta. Whatever createCampaign has to be told.
  externalAccountId   String
  externalAccountName String?
  externalBusinessId  String?

  accessToken      String    @db.Text
  refreshToken     String?   @db.Text
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  /// Space-separated list of what the network actually granted, which is not
  /// always what was asked for. Checked before an action that needs a scope,
  /// so a missing permission fails with something a person can act on.
  scopes           String?

  status    PlatformConnectionStatus @default(CONNECTED)
  lastError String?                  @db.Text

  /// TikTok: the custom identity (name and profile picture) ads appear
  /// under, made once per advertiser and reused.
  tiktokIdentityId String?

  platformCampaigns PlatformCampaign[]

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, platform])
  @@index([organizationId])
}

/// The campaign the customer thinks they made.
///
/// They name it once, set one budget, and pick which networks it should run
/// on. Everything underneath — a separate real campaign on each network, with
/// its own id, its own budget and its own status — is MAIRO's problem.
model MairoCampaign {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// Platform Intelligence: the platform capabilities this campaign was built
  /// with (feature keys from the Meta Feature Registry), so results can be
  /// compared with and without each one, per business.
  metaFeatures String[] @default([])

  name      String
  objective AdGoal
  status    CampaignStatus @default(DRAFT)

  /// The business goal this campaign serves (lib/mission), and why MAIRO
  /// planned it. Every marketing item MAIRO makes carries both.
  missionId          String?
  marketingObjective String?
  whyText            String? @db.Text

  /// When a person pressed Launch on this campaign. An account that asked
  /// MAIRO to hold before going live still has this one switched on once the
  /// network finishes reviewing it — they already said yes to it.
  launchApprovedAt DateTime?

  /// Where this campaign's ad sends people, and the value it needs.
  ///
  /// Held per campaign rather than only on the organization because one
  /// business runs different ads for different things — a booking page this
  /// month, a sale page the next — and making them edit their business
  /// profile to change one ad would be absurd. Null falls back to the
  /// organization's own answer.
  destinationType  AdDestination    @default(WEBSITE)
  destinationUrl   String?
  destinationPhone String?
  /// Which inbox, when destinationType is DIRECT_MESSAGE. Ignored otherwise.
  messageChannel   MessageChannel   @default(MESSENGER)
  /// Where the form lives, when destinationType is LEAD_FORM.
  leadFormDelivery LeadFormDelivery @default(HOSTED_PAGE)

  /// Who should see this, in the three things a business can actually answer.
  ///
  /// Every campaign MAIRO built before this targeted the whole United States,
  /// every age, because nothing ever asked. For a plumber in Austin that is the
  /// entire budget spent on people who will never call him.
  ///
  /// Meta's own id for the place, from its targeting search. Null means the
  /// whole country, which is right for a shop that posts everywhere and wrong
  /// for everyone else — so it is asked rather than assumed.
  geoKey    String?
  /// What that place is called, so the campaign can say it back to them.
  geoLabel  String?
  /// How far around it to advertise, in miles. Meta's own unit here.
  geoRadius Int?
  ageMin    Int     @default(18)
  ageMax    Int     @default(65)
  /// 0 everyone, 1 men, 2 women — Meta's own numbering, kept so nothing has to
  /// translate it twice.
  genders   Int     @default(0)

  /// The one number the customer entered. The children's budgets are derived
  /// from this and their allocation percentages, and are kept summing to it.
  totalDailyBudgetCents Int

  /// When the customer wants the ads to start, as an absolute instant.
  ///
  /// Null means "as soon as Meta approves it", which is the default and what
  /// most people want. A date here is a floor, never a promise: Meta's review
  /// is asynchronous and nothing delivers before it passes, so the real start
  /// is the later of this and the approval.
  ///
  /// Enforced twice on purpose. It is sent to the network as the ad set's
  /// start_time, so the network itself holds delivery even if MAIRO is wrong
  /// about something; and auto-launch refuses to un-pause before it, so a
  /// network that quietly ignored the field can't start early either.
  startDate DateTime?

  /// The IANA zone the customer picked that time in, e.g. "America/Chicago".
  ///
  /// The instant above is unambiguous on its own; this is what lets every
  /// screen echo back the wall-clock time they actually chose rather than
  /// re-rendering it in whatever zone the current device happens to be in.
  startTimeZone String?

  /// When delivery stops. Null runs until someone stops it.
  endDate DateTime?

  /// What this campaign's Meta ad is made of. Null follows the business-wide
  /// choice on the Sales setup screen, which is what campaigns made anywhere
  /// other than the Create flow get.
  adSource              CampaignAdSource?
  /// The Facebook post to run, as Meta's {page-id}_{post-id}.
  boostPostId           String?
  /// The Instagram post to run, as its media id.
  boostInstagramMediaId String?
  /// Where the Meta ad shows. Empty lets Meta choose, which is its advice.
  placements            MetaPlacement[]    @default([])
  /// Set when the ad falls in one of Meta's special categories.
  specialAdCategory     SpecialAdCategory?
  /// Whether Meta may widen the audience beyond what was chosen (Advantage+ audience).
  advantageAudience     Boolean            @default(false)
  budgetType            BudgetType         @default(DAILY)
  /// The whole run's budget when budgetType is LIFETIME.
  lifetimeBudgetCents   Int?
  /// The advertised app's Meta app id, for app campaigns.
  metaAppId             String?
  /// What the customer said they're advertising (business, product, offer…).
  promotes              String?

  /// Set when the customer asked for TikTok Growth Mode on this campaign:
  /// TikTok-native creative, hook variations, and Spark-ad readiness for a
  /// business that has little or no following yet.
  tiktokGrowthMode Boolean @default(false)

  platformCampaigns PlatformCampaign[]
  /// The ads this campaign runs, in order. Empty follows the business-wide
  /// creative (the most recently approved one), as campaigns always did.
  ads               CampaignAd[]
  creatives         PlatformCreative[]
  recommendations   OptimizationRecommendation[]
  /// Campaigns created before multi-platform existed, adopted by the backfill.
  legacyCampaigns   Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  /// Leads known to have come from this campaign.
  leads Lead[]
}

/// What one campaign ad is made of.
enum CampaignAdKind {
  /// An approved picture from Creative Studio.
  IMAGE
  /// A video the customer uploaded.
  VIDEO
  /// An ad already in the customer's Meta ad account, run again as it is.
  EXISTING_AD
}

/// One ad a campaign runs. Several when the customer tests versions.
model CampaignAd {
  id              String         @id @default(cuid())
  mairoCampaign   MairoCampaign  @relation(fields: [mairoCampaignId], references: [id], onDelete: Cascade)
  mairoCampaignId String
  /// 0 is the main ad; the rest are test versions.
  position        Int
  kind            CampaignAdKind

  /// IMAGE: the approved creative whose picture runs.
  creativeRequestId String?
  /// IMAGE: a picture the customer uploaded themselves, instead.
  imageUrl          String?
  /// VIDEO: where the upload lives, and a still for the thumbnail.
  videoUrl          String?
  videoPosterUrl    String?
  /// VIDEO: Meta's id once uploaded, so a retry doesn't upload it again.
  metaVideoId       String?
  /// EXISTING_AD: the Meta ad whose creative runs again.
  sourceAdId        String?
  sourceAdName      String?

  /// The words the customer chose. Null on an existing ad.
  headline     String?
  primaryText  String? @db.Text
  callToAction String?

  /// The Strategy Engine's brief for this creative (JSON): primary goal,
  /// marketing objective, audience, hook, message, CTA, format and the reason
  /// it was made. See briefFor in lib/engine/core.ts.
  briefJson String? @db.Text

  createdAt DateTime @default(now())

  @@index([mairoCampaignId])
}

/// One network's half of a Mairo campaign.
model PlatformCampaign {
  id              String        @id @default(cuid())
  mairoCampaign   MairoCampaign @relation(fields: [mairoCampaignId], references: [id], onDelete: Cascade)
  mairoCampaignId String

  platform     AdPlatform
  connection   PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId String?

  /// Null until the campaign actually reached the network. A row with a
  /// budget, a status of DRAFT and no external id is one that failed to push
  /// and is waiting to be retried — not one that is quietly running.
  externalCampaignId String?
  /// The ad set (Meta) or ad group (TikTok) beneath the campaign.
  ///
  /// Recorded because a campaign is not a deliverable thing on its own: with
  /// no ad set and no ad it cannot serve a single impression. These two
  /// columns are what let the dashboard tell a customer how far a launch
  /// actually got, and what let a retry finish the job instead of creating a
  /// second campaign beside the first.
  externalAdGroupId  String?
  /// The ad itself. Until this exists, nothing delivers.
  externalAdId       String?
  /// Further ads in the same ad set, when the customer is testing versions.
  /// Switched on alongside externalAdId.
  extraExternalAdIds String[] @default([])
  /// TikTok only: built through TikTok's Smart+ endpoints rather than the
  /// original campaign/ad group/ad ones. Decided once, when the campaign is
  /// created, and read back by every later call — Smart+ campaigns are paused,
  /// resumed and re-budgeted through their own endpoints, and a campaign
  /// started on one API cannot be finished or managed on the other.
  tiktokSmartPlus    Boolean  @default(false)

  /// What Meta's ad review last said about this campaign's ads, in plain
  /// English (see src/lib/meta/ad-review.ts). Null until first checked.
  adReviewState       String?
  adReviewExplanation String?   @db.Text
  adReviewAction      String?   @db.Text
  adReviewCheckedAt   DateTime?

  /// Whole per cent of the parent's budget. Siblings always sum to 100; that
  /// is enforced in src/lib/budget/allocation.ts rather than by the database,
  /// because the check spans rows.
  budgetPercent       Int
  dailyBudgetCents    Int
  /// This network's share of a total-budget campaign. Null for daily budgets.
  lifetimeBudgetCents Int?

  status    CampaignStatus @default(DRAFT)
  lastError String?        @db.Text

  creatives PlatformCreative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mairoCampaignId, platform])
  @@index([mairoCampaignId])
}

/// The shapes a creative can be cut to.
///
/// This is on the creative rather than inferred from the platform because one
/// platform takes several: a Meta campaign wants 9:16 for Stories and Reels
/// and 1:1 for feed, from the same brief.
enum CreativeAspect {
  SQUARE_1_1
  PORTRAIT_4_5
  VERTICAL_9_16
  LANDSCAPE_16_9
}

/// A single ad creative, written for one network in particular.
///
/// Meta and TikTok do not take the same advertisement. A polished product film
/// that works in a Facebook feed dies in the first second of a TikTok, and a
/// hand-held creator-style clip with burned-in subtitles looks like a mistake
/// in a carousel. So the creative carries the platform it was written for, and
/// the generator is given a different brief for each — see
/// src/lib/ai/creative-briefs.ts.
model PlatformCreative {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  mairoCampaign      MairoCampaign?    @relation(fields: [mairoCampaignId], references: [id], onDelete: Cascade)
  mairoCampaignId    String?
  platformCampaign   PlatformCampaign? @relation(fields: [platformCampaignId], references: [id], onDelete: SetNull)
  platformCampaignId String?

  platform     AdPlatform
  creativeType CreativeType
  aspectRatio  CreativeAspect

  /// The first one to three seconds. Its own column rather than part of the
  /// body copy because on TikTok it is the whole ad — everything after it only
  /// gets seen if the hook works — and because hook variations are the unit
  /// creative testing compares.
  hook        String? @db.Text
  primaryText String? @db.Text
  headline    String?
  cta         String?
  mediaUrl    String? @db.Text

  /// Per-creative figures from the network, as JSON. Untyped on purpose: the
  /// interesting metrics differ per platform (TikTok cares about six-second
  /// views and completion rate, Meta does not report them) and pinning columns
  /// for the union of every network's vocabulary ages badly.
  performanceData String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([mairoCampaignId])
}

enum RecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
  EXPIRED
}

/// A proposed change to how a campaign's budget is split.
///
/// Stored rather than computed on the fly so that applying one is auditable:
/// what was proposed, on what evidence, who accepted it, and whether MAIRO
/// applied it itself under Auto Optimize. Money moves here, and "the AI
/// changed my budget and I don't know why" is not an acceptable state.
model OptimizationRecommendation {
  id              String        @id @default(cuid())
  mairoCampaign   MairoCampaign @relation(fields: [mairoCampaignId], references: [id], onDelete: Cascade)
  mairoCampaignId String

  status       RecommendationStatus @default(PENDING)
  /// Plain-language reason shown to the customer.
  rationale    String               @db.Text
  /// JSON: [{ platform, fromPercent, toPercent }]
  proposalJson String               @db.Text
  /// JSON snapshot of the figures this was based on, so a recommendation can
  /// still be explained a week later when the numbers have moved on.
  evidenceJson String?              @db.Text

  appliedAt   DateTime?
  appliedById String?
  /// True when Auto Optimize applied this without a person clicking anything.
  automatic   Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([mairoCampaignId])
}

/// The limits a customer puts on what MAIRO may do to their budget by itself.
///
/// Off by default, and every field is a ceiling rather than a target. The
/// enforcement lives in src/lib/budget/optimizer.ts and runs server-side on
/// every automatic change — a customer's stated maximum is the one thing in
/// this feature that must not be advisory.
model AutoOptimizeSettings {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// How much MAIRO may do without asking.
  ///
  /// This replaced a bare on/off switch. `enabled` is kept in step with it —
  /// MANUAL is off, the other two are on — because the guardrail check and a
  /// good deal of older code read it, and a second field that can disagree
  /// with this one is a way for the product to act against what the settings
  /// page says it will do.
  level AutomationLevel @default(MANUAL)

  enabled Boolean @default(false)

  /// The largest share of a campaign's budget MAIRO may move in one day,
  /// whole per cent. Distinct from maxDailyIncreasePercent, which caps how
  /// much any single platform's share may grow; this caps the whole movement.
  maxBudgetShiftPercent Int @default(15)

  /// Hard ceiling on total daily spend across every platform.
  maxDailyBudgetCents     Int
  /// How much MAIRO may raise a daily budget in one day, as a percentage of
  /// the current budget. Stops a good week compounding into a bad month.
  maxDailyIncreasePercent Int    @default(20)
  /// Floor and ceiling on performance. Below the ROAS or above the CPA, MAIRO
  /// may only reduce spend, never increase it.
  minRoas                 Float?
  maxCpaCents             Int?

  /// The networks MAIRO is allowed to touch. Empty means none.
  platforms AdPlatform[]

  /// How much MAIRO may cut a budget in one day, whole per cent.
  maxDailyDecreasePercent      Int     @default(30)
  /// Guardrails that hold a change for approval even when the automation
  /// level would otherwise allow it. New campaigns always need approval and
  /// have no switch — see ALWAYS_NEEDS_APPROVAL in src/lib/automation/levels.ts.
  requireApprovalNewCreatives  Boolean @default(true)
  requireApprovalAudience      Boolean @default(true)
  requireApprovalPlatformShift Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What Spend Protection does when a limit is hit.
enum ProtectionAction {
  /// Tell the customer; change nothing.
  NOTIFY
  /// Pause the campaign on the network, then tell the customer.
  PAUSE
}

/// The customer's own spending limits, checked on a schedule whatever the
/// automation level. Protective only: nothing here can raise a budget or
/// start a campaign — it can only warn, or pause.
model SpendProtection {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// A campaign that spends this much without a single result is flagged.
  /// Null switches the check off.
  stopLossCents   Int?             @default(5000)
  stopLossAction  ProtectionAction @default(NOTIFY)
  /// Account-wide spend for the calendar month. Reaching it pauses every
  /// running MAIRO campaign. Null switches it off.
  monthlyCapCents Int?
  /// Warn when month-to-date spend passes this share of the cap.
  warnAtPercent   Int              @default(80)
  /// When the limits were last checked, so a page load doesn't recheck them
  /// every time.
  checkedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Every warning and pause Spend Protection made, and every resume after one,
/// with the figures it was based on. The audit trail for "why did it stop?".
model ProtectionEvent {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mairoCampaignId String?
  /// STOP_LOSS, MONTHLY_CAP_WARNING, MONTHLY_CAP_REACHED, RESUMED, PAUSED_BY_YOU
  kind            String
  /// NOTIFIED, PAUSED or RESUMED.
  action          String
  message         String       @db.Text
  amountCents     Int?
  createdAt       DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([mairoCampaignId])
}

/// Pricing and feature permissions, in the database rather than in the code.
///
/// The point is that changing what a plan costs or what it unlocks should be a
/// row edit, not a deploy. src/lib/entitlements.ts reads this table, falls back
/// to the defaults compiled into src/lib/plans.ts when a row is missing, and is
/// the only thing in the application allowed to answer "may this organization
/// do X" — so there is exactly one place to change when pricing changes.
///
/// The tier is the primary key and stays an enum, because Stripe price ids are
/// keyed off it in the environment and renaming one would strip existing
/// subscribers of their plan on the next webhook.
model PlanConfig {
  tier SubscriptionTier @id

  name             String
  priceMonthly     Int // cents
  tagline          String
  spendGuidance    String  @default("")
  featured         Boolean @default(false)
  active           Boolean @default(true)
  sortOrder        Int     @default(0)
  /// JSON string[] — the bullet list shown on the pricing card.
  featuresJson     String  @db.Text
  /// JSON object keyed by the flags in src/lib/entitlements.ts.
  entitlementsJson String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// How far along MAIRO is with setting a customer's TikTok account up for them.
///
/// This is a worked queue, not an API call, and the enum says so. TikTok has no
/// endpoint that creates a TikTok account — no network does, because account
/// creation is where they enforce their own identity and anti-abuse checks. So
/// "MAIRO sets your TikTok up for you" is real work someone does on the
/// customer's behalf, and these are the states that work actually passes
/// through.
enum ManagedSetupStatus {
  /// The customer asked. Nobody has picked it up yet.
  REQUESTED
  /// Someone at MAIRO is working on it.
  IN_PROGRESS
  /// Blocked on the customer — a verification code, a decision, a document.
  NEEDS_CUSTOMER
  /// The account exists and the customer has been handed the login.
  READY
  /// Not going ahead, with a reason.
  DECLINED
}

/// A customer asking MAIRO to create their TikTok presence for them.
///
/// The business owners MAIRO is for very often have no TikTok at all, and the
/// gap between "I'd like to advertise on TikTok" and "I have a TikTok Business
/// account, a Business Center, and an advertiser id" is where most of them
/// stop. This is the record of MAIRO closing that gap for them.
///
/// Nothing in here is a credential. The account MAIRO creates belongs to the
/// customer and its password is handed to them out of band — storing it would
/// make MAIRO the custodian of a login it has no business holding, and would
/// break the promise in the Terms that MAIRO never stores platform passwords.
model ManagedAccountSetup {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  platform       AdPlatform

  status ManagedSetupStatus @default(REQUESTED)

  /// What the customer wants to be called on the platform, and their fallbacks
  /// — handles are first-come-first-served and the first choice is usually gone.
  preferredHandle  String?
  alternateHandles String?
  /// Where MAIRO reaches them for the verification steps only they can do.
  contactEmail     String
  contactPhone     String?
  /// The business as it should appear on the account.
  displayName      String
  category         String?
  bio              String? @db.Text
  websiteUrl       String?

  /// What the customer told us, and what we told them. Not a chat — a record.
  customerNotes String? @db.Text
  internalNotes String? @db.Text

  /// Set once the account exists. The handle, not a credential.
  createdHandle String?
  /// Where the customer goes to take ownership.
  handoffUrl    String?

  requestedAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  /// One open request per platform at a time; a finished one is closed first.
  @@index([organizationId, platform])
  @@index([status])
}

/// Where a video MAIRO posted to TikTok on the customer's behalf got to.
///
/// Mirrors TikTok's own Content Posting states rather than inventing simpler
/// ones, because the differences are the ones a customer asks about. A video
/// that reached TikTok and is still transcoding is not the same as one that
/// published, and neither is the same as one that landed in the creator's
/// drafts because MAIRO only had upload permission rather than publish
/// permission.
enum TikTokPostStatus {
  /// Written, not sent.
  DRAFT
  /// Bytes going to TikTok.
  UPLOADING
  /// TikTok has it and is processing.
  PROCESSING
  /// Live on the customer's profile.
  PUBLISHED
  /// In the customer's TikTok drafts for them to post themselves.
  IN_TIKTOK_DRAFTS
  /// TikTok refused it, or the upload broke. `error` says which.
  FAILED
}

/// How the video was sent.
enum TikTokPostMode {
  /// Straight to the profile. Needs the video.publish scope and an audited app.
  DIRECT_POST
  /// Into the creator's TikTok inbox/drafts. Needs only video.upload.
  INBOX
}

/// One video MAIRO posted, or tried to post, to a customer's TikTok.
///
/// Every row here is a real call to TikTok's Content Posting API — there is no
/// path that writes a PUBLISHED row without TikTok having said so. A post that
/// was never sent stays DRAFT and a post TikTok refused is FAILED with its own
/// words in `error`, because a customer looking at this list is entitled to
/// know what is actually on their profile.
model TikTokPost {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// The creative this came from, when it came from one.
  creativeRequest   CreativeRequest? @relation(fields: [creativeRequestId], references: [id], onDelete: SetNull)
  creativeRequestId String?

  caption      String @db.Text
  /// TikTok's own value: PUBLIC_TO_EVERYONE, MUTUAL_FOLLOW_FRIENDS, SELF_ONLY.
  /// Stored as text because TikTok adds them and the set differs per creator.
  privacyLevel String @default("SELF_ONLY")

  mode   TikTokPostMode   @default(INBOX)
  status TikTokPostStatus @default(DRAFT)

  /// TikTok's handle on the publish job, used to poll for the outcome.
  publishId String? @unique
  /// The finished post, once TikTok gives it to us.
  postUrl   String?
  /// TikTok's own words when it refused. Shown to the customer.
  error     String? @db.Text

  /// Source video. A data URL is never stored here — this is an https URL to
  /// the file MAIRO uploaded from.
  sourceUrl       String? @db.Text
  durationSeconds Int?
  sizeBytes       Int?

  postedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, status])
}

/// The customer's authorization for MAIRO to post on their TikTok profile.
///
/// Deliberately separate from PlatformConnection, because it genuinely is a
/// separate thing and hiding that would cause bugs. TikTok has two APIs that
/// share a name and nothing else: the Business API at business-api.tiktok.com,
/// which spends money on advertising and authenticates with an `Access-Token`
/// header against an advertiser id; and the Open API at open.tiktokapis.com,
/// which posts videos to a person's profile and authenticates with a normal
/// OAuth bearer token against a creator. Different hosts, different consent
/// screens, different scopes, different token shapes, and an advertiser token
/// is rejected by the posting endpoints.
///
/// So connecting TikTok for ads does not grant posting, and a customer who
/// wants both authorizes twice. That is TikTok's design, not MAIRO's, and
/// modelling it as one row would only mean discovering it later at runtime.
model TikTokCreatorConnection {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// TikTok's stable id for the creator under this app.
  openId    String
  unionId   String?
  username  String?
  nickname  String?
  avatarUrl String? @db.Text

  accessToken      String    @db.Text
  refreshToken     String?   @db.Text
  tokenExpiresAt   DateTime?
  refreshExpiresAt DateTime?
  /// Space-separated. video.upload alone means drafts only; video.publish is
  /// what allows posting straight to the profile.
  scopes           String?

  status    PlatformConnectionStatus @default(CONNECTED)
  lastError String?                  @db.Text

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Whether a pixel is actually doing anything.
///
/// The distinction that matters is PENDING versus NO_EVENTS. A pixel that
/// exists but has never fired looks identical to a working one in every
/// dashboard — same id, same name, same green tick — and the customer finds
/// out months later that none of their ROAS was ever real. So "created" and
/// "receiving events" are different states here and are shown differently.
enum PixelStatus {
  /// Created on the network. Nothing has been installed yet.
  PENDING
  /// The network has seen events from it. This is the only good state.
  ACTIVE
  /// Installed, or claimed to be, but the network has seen nothing.
  NO_EVENTS
  /// The network refused to talk about it. Never guessed at.
  ERROR
}

/// How the pixel came to exist.
enum PixelOrigin {
  /// MAIRO created it through the network's API.
  CREATED_BY_MAIRO
  /// The customer already had one and told us its id.
  EXISTING
}

/// One network's conversion tracking for one business.
///
/// A pixel is the thing that makes ROAS possible at all: without one, the ad
/// network has no idea that anybody bought anything, reports no revenue, and
/// every ROAS figure on the dashboard is null. That is the current state of
/// MAIRO for every customer, and nothing in the product said so.
model TrackingPixel {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  platform       AdPlatform

  /// The network's own id, which is what goes in the snippet.
  externalPixelId String
  name            String
  origin          PixelOrigin @default(CREATED_BY_MAIRO)

  status        PixelStatus @default(PENDING)
  /// When the network last saw an event. The only honest proof it works.
  lastFiredAt   DateTime?
  lastCheckedAt DateTime?
  lastError     String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, platform])
  @@index([organizationId])
}

/// A form MAIRO wrote and hosts, so nobody has to build one.
///
/// The questions are authored per trade in src/lib/leads/templates.ts rather
/// than left to the business, because a business owner asked to design a form
/// produces three fields that tell them nothing or fifteen nobody finishes —
/// and asked to build one inside Facebook's form builder, mostly does not.
///
/// Deliberately hosted by MAIRO rather than created on a Facebook Page. Meta's
/// native instant form converts better, but creating one needs permissions
/// this app does not have yet; the fields are modelled on Meta's own question
/// list so the same form can be pushed there later without being redesigned.
model LeadForm {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// The public path the ad links to: /f/<slug>. Random rather than derived
  /// from the business name, so one customer's form cannot be guessed from
  /// another's and a rename never breaks a live ad.
  slug String @unique

  name        String
  headline    String
  description String @db.Text
  thankYou    String @db.Text
  /// LeadField[] as written by the template, then edited by the customer.
  fieldsJson  String @db.Text

  /// Set once the same questions are pushed to a Facebook Page.
  metaFormId   String?
  /// When submissions were last pulled off Meta, so a sync asks only for what
  /// is new rather than re-reading the whole history each time.
  metaSyncedAt DateTime?
  /// Why the last push or sync failed, kept so the customer can be told.
  metaError    String?   @db.Text

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Where a lead came from. The hosted form today, Meta's own form later.
enum LeadSource {
  MAIRO_FORM
  META_INSTANT
}

/// What became of a lead. NEW is all a form or Meta can tell MAIRO; every
/// step after that is the business's word.
enum LeadStatus {
  NEW
  /// Somebody at the business has been in touch with them.
  CONTACTED
  /// A real prospect the business wants — not spam, in the area, wants the service.
  QUALIFIED
  /// An appointment, estimate or call booked.
  BOOKED
  /// A quote or estimate sent, waiting on an answer.
  ESTIMATE_SENT
  /// Became a paying customer.
  WON
  /// Didn't go anywhere.
  LOST
  /// Junk, a test, or a duplicate.
  SPAM
}

/// One person who filled the form in.
model Lead {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  leadForm       LeadForm     @relation(fields: [leadFormId], references: [id], onDelete: Cascade)
  leadFormId     String

  source LeadSource @default(MAIRO_FORM)

  /// Answers keyed by LeadField.key. Stored whole rather than in columns
  /// because the questions differ per business and change over time — a
  /// column per question would need a migration every time somebody edits
  /// their form.
  answersJson String @db.Text

  /// For matching this person back to the ad they saw.
  ///
  /// Hashed on arrival and never stored in the clear, which is the same rule
  /// the order ingest follows: MAIRO does not keep customers' contact details,
  /// it keeps the fingerprint the networks need to attribute a conversion.
  hashedEmail String?
  hashedPhone String?

  /// Meta's click id, if the ad carried one. The strongest match there is.
  clickId String?

  /// Meta's own id for a submission on a native form.
  ///
  /// Unique, because a sync that runs twice must not store the same person
  /// twice — and a sync will run twice, on every schedule and every retry.
  externalLeadId String? @unique

  /// What became of this person, as the business marks it. A form filled in
  /// is a reported lead and nothing more until somebody says otherwise —
  /// MAIRO never assumes a lead was qualified, booked or paid.
  status          LeadStatus @default(NEW)
  /// What the job was worth, when the business says it became a customer.
  valueCents      Int?
  statusChangedAt DateTime?

  /// When this lead was reported to Meta as a "Lead" (Conversions API), so
  /// Meta can count and optimize towards leads that arrive on MAIRO's own
  /// form — otherwise invisible to it. Null until sent. Only for MAIRO_FORM
  /// leads: a native form's lead is already Meta's.
  metaReportedAt  DateTime?
  /// Why it couldn't be sent, or a warning about how well it can be matched.
  metaReportError String?   @db.Text

  /// The campaign this lead came from — only when that is reliably known: the
  /// ad's link to MAIRO's form carried it, or Meta's instant form said so.
  /// Never guessed from timing. Null means "not known", not "no campaign".
  mairoCampaign   MairoCampaign? @relation(fields: [mairoCampaignId], references: [id], onDelete: SetNull)
  mairoCampaignId String?

  /// Follow-up, as the business records it. The first contact is what
  /// response time is measured from; nothing here is inferred.
  firstContactedAt DateTime?
  lastContactedAt  DateTime?
  /// When the next follow-up is due, if the business set one.
  nextFollowUpAt   DateTime?
  appointmentAt    DateTime?
  /// What the business expects the job to be worth (an estimate). Never revenue.
  estimatedValueCents Int?
  /// Why it didn't go anywhere, for LOST: one of the reasons in lib/leads/details.
  lostReason       String?
  /// The business's own notes. Private to the business.
  notes            String?   @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([leadFormId])
  @@index([mairoCampaignId])
}

/// Where an order came from.
enum OrderSource {
  SHOPIFY
  WOOCOMMERCE
  STRIPE
  /// Posted to MAIRO's endpoint by something else, in MAIRO's own shape.
  CUSTOM
  /// Typed in by hand, for a business that takes orders off the internet.
  MANUAL
}

/// An order the business actually took.
///
/// This is the half of measurement a pixel cannot give you. A browser pixel is
/// lossy by design — ad blockers, iOS tracking prompts and Safari's cookie
/// policy between them lose a serious fraction of conversions, and the network
/// only ever reports what reached it. The store, by contrast, knows exactly
/// what was sold.
///
/// So MAIRO takes orders straight from the store and does two things with
/// them: forwards them server-side to each network's conversions API, which
/// recovers most of what the browser lost, and keeps them here as the record
/// against which the networks' own claims can be checked.
model ConversionEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  source          OrderSource
  /// The store's own order id. Unique per organization, so a webhook that
  /// arrives twice — which Shopify's retries guarantee — is recorded once.
  externalOrderId String
  /// Meta and TikTok both dedupe browser and server copies of the same
  /// conversion on this. It has to be the same string in both places, so it
  /// is derived from the order id rather than generated.
  eventId         String
  eventName       String      @default("Purchase")

  valueCents Int
  currency   String   @default("USD")
  occurredAt DateTime

  /// Hashed before it is ever written — see src/lib/tracking/hash.ts. MAIRO
  /// never stores a customer's email or phone in the clear for this purpose.
  hashedEmail String?
  hashedPhone String?
  /// Kept in the clear because they are not identifying on their own and the
  /// networks match noticeably better with them.
  country     String?
  /// The visitor's own browser identifiers, when the store passes them on.
  /// They are what lifts match quality from poor to good.
  clientIp    String?
  userAgent   String? @db.Text
  fbclid      String?
  ttclid      String?

  forwards ConversionForward[]

  createdAt DateTime @default(now())

  @@unique([organizationId, externalOrderId])
  @@index([organizationId, occurredAt])
}

enum ForwardStatus {
  PENDING
  SENT
  /// The network took it but said something about it worth keeping.
  ACCEPTED_WITH_WARNINGS
  FAILED
  /// No pixel, or no connection, on that network. Not a failure.
  SKIPPED
}

/// What happened when MAIRO sent one order to one network.
///
/// Per network and per order rather than a status column, because the answer
/// genuinely differs: the same order can reach Meta and be refused by TikTok,
/// and a customer asking why their TikTok ROAS is low deserves to see that
/// rather than a single green tick covering both.
model ConversionForward {
  id       String          @id @default(cuid())
  event    ConversionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  platform AdPlatform

  status        ForwardStatus @default(PENDING)
  /// The network's own words when it refused or complained.
  message       String?       @db.Text
  /// How many of the identifiers the network could match on, out of what was
  /// sent. Low numbers are the usual reason attribution looks worse than it is.
  matchedFields Int?
  sentAt        DateTime?

  @@unique([eventId, platform])
  @@index([platform, status])
}

/// The secret that lets a store post orders to MAIRO.
///
/// A token in the URL rather than an API key in a header, because the thing on
/// the other end is very often a Shopify webhook field or a WooCommerce plugin
/// box that accepts a URL and nothing else. Shopify's HMAC signature is
/// verified on top of it where the store sends one.
model StoreIngest {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// Random, in the URL path. Rotatable — rotating invalidates the old URL.
  token         String  @unique
  /// Shopify's webhook signing secret, when they are on Shopify. Encrypted.
  shopifySecret String? @db.Text

  lastReceivedAt DateTime?
  receivedCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// How one business measures conversions, above the per-network pixels.
///
/// Separate from TrackingPixel because it is a different question. A pixel is
/// per network and answers "can Meta see anything". This answers "what counts
/// as a conversion for this business at all" — which is one decision, made
/// once, and applies to every network they advertise on.
///
/// The niche is stored rather than recomputed from the industry text because
/// the customer can correct it. MAIRO guesses from what they typed at signup,
/// shows the guess, and lets them change it — and a correction that does not
/// survive a page reload is not a correction.
model TrackingProfile {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// An id from src/lib/tracking/niches.ts. Text rather than an enum so the
  /// catalogue can grow without a migration — a niche that no longer exists
  /// falls back to the general one rather than breaking the page.
  nicheId        String  @default("general")
  /// True once the customer has picked, so MAIRO stops presenting its guess
  /// as a question they have already answered.
  nicheConfirmed Boolean @default(false)

  /// Their Google Tag Manager container, e.g. GTM-ABC1234.
  gtmContainerId   String?
  /// When they last took the container file. Not proof it was imported —
  /// only that they got as far as downloading it.
  containerBuiltAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A customer's authorization for MAIRO to write tags into their Tag Manager.
///
/// Separate from every other connection in here because it is a third kind of
/// credential: Google's, not an ad network's. It grants nothing on Meta or
/// TikTok and buys no advertising — it lets MAIRO create and publish tags in a
/// container the customer owns, which is a narrow and unusually powerful
/// permission. A mistake here edits the tracking on their live website.
///
/// So the scopes are the minimum that can do the job and are stored as granted
/// rather than as requested: Google will happily issue a token with a subset if
/// the user unticks a box, and publishing without the publish scope fails at
/// the last step, after the tags are already created.
model GtmConnection {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// Google's stable id for the person who authorized. Not an email.
  googleUserId String?
  /// Shown so the customer can tell which Google account is connected.
  googleEmail  String?

  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  tokenExpiresAt DateTime?
  /// Space-separated, as granted. Checked before publishing rather than after.
  scopes         String?

  /// Which container MAIRO writes to. Null until the customer picks one —
  /// a Google account can administer dozens and guessing would edit the
  /// tracking on somebody's live website.
  gtmAccountId       String?
  gtmContainerId     String?
  /// The GTM-XXXXXXX the customer recognises.
  gtmContainerPublic String?
  gtmContainerName   String?
  /// MAIRO's own workspace, so its changes never sit in a draft somebody else
  /// is halfway through.
  gtmWorkspaceId     String?

  status            PlatformConnectionStatus @default(CONNECTED)
  lastError         String?                  @db.Text
  /// When MAIRO last successfully published tags into the container.
  lastPublishedAt   DateTime?
  /// What was published, so the page can say what is live without asking
  /// Google on every load.
  publishedTagCount Int?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// How far an Instagram post got.
///
/// Instagram publishes in two calls — a container is created, then published —
/// and a container can be accepted and still fail during processing. So CREATED
/// is a real state and not an implementation detail: the customer has a post
/// Instagram has accepted but not yet put on their profile.
enum InstagramPostStatus {
  /// Proposed by MAIRO in a posting plan. Never published until approved.
  SUGGESTED
  /// Approved, waiting for its time.
  SCHEDULED
  /// Written, not sent.
  DRAFT
  /// Instagram has the media and is processing it.
  CREATED
  /// Live on the customer's profile.
  PUBLISHED
  /// Instagram refused it, or processing failed.
  FAILED
  /// The business chose not to post it.
  SKIPPED
  /// Was approved, but Scale stopped being active. Never published until the
  /// business is on active Scale again and resumes it.
  PAUSED
}

/// A post MAIRO published to the customer's own Instagram.
///
/// Separate from TikTokPost rather than folded into one "social posts" table.
/// The two flows genuinely differ: TikTok has an inbox mode where the video
/// lands in the customer's drafts for them to post themselves, and a privacy
/// level chosen per creator; Instagram has neither, and has a container step
/// that TikTok has no equivalent of. One table would be two thirds nullable
/// columns and a status enum nothing could reason about.
model InstagramPost {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// The creative this came from, when it came from one.
  creativeRequest   CreativeRequest? @relation(fields: [creativeRequestId], references: [id], onDelete: SetNull)
  creativeRequestId String?

  caption String @db.Text

  status InstagramPostStatus @default(DRAFT)

  /// The Instagram Business account this went to. Recorded per post because a
  /// customer can reconnect a different Page, and a post made to the old
  /// profile is not reachable from the new one.
  igUserId    String?
  /// Instagram's handle on the pending container, between the two calls.
  containerId String?
  /// The finished post's own id, once Instagram publishes it.
  mediaId     String? @unique
  permalink   String?
  /// Instagram's own words when it refused. Shown to the customer.
  error       String? @db.Text

  /// The picture Instagram was told to fetch. An https URL — Instagram pulls
  /// the bytes itself and will not accept a data URL or an upload.
  sourceUrl String? @db.Text

  /// INSTAGRAM or FACEBOOK (the business's Facebook Page). Same approval
  /// flow either way; only the publishing calls differ.
  network          String    @default("INSTAGRAM")
  /// IMAGE, CAROUSEL or REEL.
  mediaType        String    @default("IMAGE")
  /// Where each picture or the video comes from, in order: "creative:<id>"
  /// for an approved creative, or an https address (Creative Studio, a
  /// campaign video). Pictures are served to Instagram as JPEG through
  /// /api/social/media; a Reel's video is handed over as it is.
  mediaRefs        String[]  @default([])
  /// A small picture to show in MAIRO's own lists.
  previewUrl       String?   @db.Text
  /// When it should go out. Null means as soon as it's approved.
  scheduledFor     DateTime?
  approvedAt       DateTime?
  /// True when MAIRO proposed it as part of a posting plan.
  suggestedByMairo Boolean   @default(false)
  /// Publishing attempts, so a stuck post stops being retried.
  attempts         Int       @default(0)

  postedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  /// The marketing objective this post serves: Awareness, Education, Trust,
  /// Consideration, Lead generation, Conversion, Booking, Retention,
  /// Promotion or Product launch.
  marketingObjective String?
  /// The Strategy Engine's brief (JSON): goal, objective, audience, hook,
  /// message, CTA, format and reason.
  briefJson          String?          @db.Text
  /// Social Manager: what kind of post this is ("Product demonstration"),
  /// the goal it serves, and why MAIRO planned it. Shown on every card.
  contentType        String?
  objective          String?
  rationale          String?          @db.Text
  /// The call to action, also written into the caption.
  cta                String?
  /// For a planned post that still needs a picture or video: what to make.
  creativeIdea       String?          @db.Text
  promotion          SocialPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionId        String?
  /// Its place in a promotion or launch, e.g. "Teaser", "Last chance".
  sequenceStep       String?
  /// Approved by Autopilot under the business's own rules, not by a person.
  autoApproved       Boolean          @default(false)
  /// Likes and comments read back from Instagram or Facebook after posting.
  likeCount          Int?
  commentCount       Int?
  metricsAt          DateTime?

  @@index([organizationId, status])
  @@index([status, scheduledFor])
  @@index([organizationId, network, status])
  @@index([organizationId, scheduledFor])
}

/// MAIRO Social Manager (Scale only): what the business wants its social
/// media to achieve, and the strategy MAIRO built for it. Every planned post
/// serves this goal.
model SocialStrategy {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// One of the goals in lib/social/goals.ts, e.g. INCREASE_SALES.
  goal         String
  /// The goal in the business's own words, when they gave them.
  goalDetail   String   @default("") @db.Text
  /// Where MAIRO posts: INSTAGRAM and/or FACEBOOK.
  platforms    String[] @default([])
  /// APPROVAL_REQUIRED (default), WEEKLY or AUTOPILOT.
  approvalMode String   @default("APPROVAL_REQUIRED")
  postsPerWeek Int      @default(4)
  /// The strategy MAIRO built (JSON: summary, pillars, cadence, CTAs).
  strategyJson String   @db.Text
  aiUsed       Boolean  @default(false)

  /// Set when Scale stopped being active: nothing is generated or posted.
  pausedAt     DateTime?
  pausedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Something happening at the business that Social Manager markets: a sale,
/// a new product or service, an event, a holiday promotion.
model SocialPromotion {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// SALE, NEW_PRODUCT, NEW_SERVICE, EVENT, NEW_INVENTORY, HOLIDAY, ANNOUNCEMENT.
  kind        String
  title       String
  /// What the business told MAIRO (JSON): offer, code, dates, restrictions…
  detailsJson String    @db.Text
  startsAt    DateTime?
  endsAt      DateTime?
  /// ACTIVE, ENDED or CANCELLED.
  status      String    @default("ACTIVE")

  posts InstagramPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

// --- AI Creative Studio ----------------------------------------------------
//
// Every image a business makes or uploads through the Studio, with real
// object storage behind it (not a data-URL text column — see the comment on
// CreativeStudioVersion), a version history per creative concept, and a
// credit ledger that meters OpenAI calls separately from the older Creatives
// page's monthly request count.
//
// A finished image reaches an actual campaign through the EXISTING pipeline:
// choosing one creates a CreativeRequest + a final, reviewed CreativeImage —
// the same rows the Creatives page has always produced, read by the same
// approvedCreativeFor() the launch code already trusts. That is deliberate:
// it is the smallest possible integration, and it means the safety review, the
// Meta/TikTok ad-creative payload, and the approval gate did not have to be
// touched or duplicated to add this.

/// How a Creative Studio asset came to exist.
enum CreativeStudioSource {
  /// Described in words, generated from nothing.
  PROMPT
  /// An uploaded product photo, transformed into an advertising image.
  PRODUCT_UPLOAD
  /// A finished ad the business already made. No model call involved.
  OWN_UPLOAD
}

enum CreativeStudioStatus {
  PENDING
  COMPLETE
  FAILED
}

/// What one pass through the pipeline actually was, for the credit ledger and
/// for the version-history UI to label rows correctly.
enum CreativeStudioActionKind {
  /// The first image in an asset's lineage.
  GENERATE
  /// A natural-language change applied to the previous version.
  EDIT
  /// One of a batch of sibling concepts made from the same brief at once.
  VARIATION
  /// No model call — the business's own file, stored as-is.
  UPLOAD
}

/// The four shapes advertising actually runs in. Named for the placement they
/// serve rather than the ratio, because "Story" means something to a business
/// owner and "9:16" does not — the ratio is still shown beside it in the UI.
enum CreativeFormat {
  /// 1:1 — the standard feed shape on every network.
  SQUARE
  /// 4:5 — the tallest ratio most feeds allow before cropping it themselves.
  PORTRAIT
  /// 9:16 — Stories and Reels, full-screen on a phone.
  STORY
  /// 16:9 — in-stream and some feed placements.
  LANDSCAPE
}

enum CreativeStylePreset {
  LUXURY_STUDIO
  STREETWEAR
  MINIMALIST
  LIFESTYLE
  CINEMATIC
  PRODUCT_PHOTOGRAPHY
  URBAN
  HIGH_FASHION
  FITNESS
  FOOD_PHOTOGRAPHY
  TECHNOLOGY
  CUSTOM
}

/// One creative concept: a prompt, an uploaded product, or an uploaded ad —
/// and everything made from it. The unit the library and the "generate 4
/// variations" grid are both built from.
model CreativeStudioAsset {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  /// Who asked for it, for the activity trail. Not a hard relation — a user
  /// can be removed from an organization without taking its creatives with it.
  createdByUserId String?

  source CreativeStudioSource
  preset CreativeStylePreset?
  format CreativeFormat       @default(SQUARE)

  /// Shared across sibling assets from one "generate N variations" batch, so
  /// the library can group and grid them. Null on everything else.
  variationGroupId String?

  /// The uploaded starting image — a product photo or the business's own
  /// finished ad — in blob storage. Null for a pure PROMPT asset.
  sourceImageUrl String? @db.Text

  /// Set once a version of this asset is attached to a campaign, which
  /// creates a CreativeRequest under the hood. Makes "Use in campaign"
  /// idempotent: clicking it again shows what already happened rather than
  /// creating a second approved creative.
  linkedCreativeRequestId String?

  /// Removed from the library view without deleting the underlying files —
  /// object storage is cleaned up separately, on a schedule, never inline
  /// with a click a person is waiting on.
  archivedAt DateTime?

  versions CreativeStudioVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, variationGroupId])
}

/// One image. The first version is the generation or the upload; every
/// version after that is one natural-language edit, each keeping the ones
/// before it rather than overwriting them — asked for explicitly in the
/// product spec, and it is also just what "undo" needs to exist at all.
model CreativeStudioVersion {
  id      String              @id @default(cuid())
  asset   CreativeStudioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId String

  version Int
  kind    CreativeStudioActionKind

  status       CreativeStudioStatus @default(PENDING)
  errorMessage String?              @db.Text

  /// What produced this version: the prompt (first pass) or the edit
  /// instruction (every pass after). Null for an UPLOAD.
  instruction String? @db.Text

  provider String  @default("openai")
  /// The exact model id used, e.g. "gpt-image-2" — recorded per version
  /// rather than assumed from today's config, because that config can change
  /// and an old row should still say what actually made it.
  model    String?

  /// Object storage, not a database column — a base64 image in Postgres was
  /// the previous approach (see CreativeImage.imageData) and is exactly what
  /// this table exists to stop doing at Studio volume. Both URLs point at the
  /// same blob store; rawImageUrl is the model's native output, imageUrl is
  /// that cropped to `format` on the parent asset. Changing the format on an
  /// existing asset re-crops from rawImageUrl rather than calling the model
  /// again — cropping is free, a generation is not.
  rawImageUrl String? @db.Text
  imageUrl    String? @db.Text
  width       Int?
  height      Int?

  creditsSpent Int @default(0)

  createdAt DateTime @default(now())

  @@unique([assetId, version])
  @@index([assetId])
}

enum CreativeCreditStatus {
  RESERVED
  CONFIRMED
}

/// Every AI Creative Studio credit, spent or reserved.
///
/// Two-phase on purpose. A generation call to OpenAI takes several seconds,
/// and holding a database lock for that long would be its own outage; not
/// holding one at all would let two requests fired together both read "under
/// the limit" and both proceed, over-spending it. So: a short transaction
/// locks the organization's own row, sums this month's RESERVED and CONFIRMED
/// credits, and — only if the new cost still fits — inserts a RESERVED row
/// and commits, which releases the lock in milliseconds. The model call then
/// runs with nothing held. On success the row is updated to CONFIRMED with
/// the asset/version it paid for; on failure it is deleted, so a failed
/// generation never costs anything. A RESERVED row past a couple of minutes
/// old is excluded from the running total — the request that made it is gone
/// either way, and an abandoned reservation must not strand real credits.
model CreativeCreditLedger {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// "2026-09" — matches CreativeRequest.month. The allowance resets on the
  /// 1st, and this is what a monthly total groups on.
  month String

  kind    CreativeStudioActionKind
  credits Int
  status  CreativeCreditStatus     @default(RESERVED)

  /// Which asset/version this spend paid for. Null while RESERVED — the
  /// version does not exist yet, the model has not answered.
  assetId   String?
  versionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, month, status])
}

/// What each kind of Studio action costs, in credits, editable without a
/// deploy. One row, a fixed id — unlike PlanConfig there is only ever one
/// live price list rather than one per tier, because what a generation costs
/// does not depend on which plan paid for it; only the monthly allowance
/// (Entitlements.studio_credits_monthly) does that.
model CreativeCreditPricing {
  id String @id @default("default")

  /// gpt-image "medium" quality — the default for a first generation.
  standardCost  Int @default(5)
  /// "high" quality — noticeably better, costs roughly 4x more to produce.
  premiumCost   Int @default(15)
  /// One natural-language change to an existing image.
  editCost      Int @default(5)
  /// Cost of ONE image within a "generate N variations" batch — the batch's
  /// total is this times N, computed at call time, never stored as a flat fee.
  variationCost Int @default(4)

  updatedAt DateTime @updatedAt
}

/// What MAIRO knows about a business, in one editable place.
///
/// Filled by the Business Analyzer from the business's own website, and
/// edited by the business under Settings > Business Brain. Every campaign,
/// ad and recommendation reads from it, so the business answers once.
///
/// The profile is JSON validated by src/lib/business/brain.ts rather than a
/// column per field: it is read and written as a whole, and a new field is a
/// code change rather than a migration.
/// The Business Brain's timeline: what changed and why, in plain words —
/// "Goal changed to Lead Generation", "You corrected: best seller is Premium
/// Detail", "MAIRO learned: before/after videos lead". Read together with the
/// mission history, promotions and learnings as one Business History.
model BrainEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// learned | corrected | removed | confirmed | product | note
  kind   String
  text   String  @db.Text
  field  String?
  /// customer | website | meta | performance | social | assistant | import | admin
  source String

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model BusinessBrain {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  /// The editable profile. See BrainProfile in src/lib/business/brain.ts.
  profileJson  String   @db.Text
  /// Fields the business typed themselves. A fresh analysis never overwrites
  /// them — what somebody corrected by hand is more reliable than a scan.
  editedFields String[] @default([])

  /// The last full analysis, with the sections that aren't part of the
  /// profile (conversion issues, the recommended strategy).
  analysisJson String?   @db.Text
  analyzedUrl  String?
  analyzedAt   DateTime?

  /// Where each fact came from and when it was last confirmed:
  /// { [field]: { source, status: "confirmed" | "inferred", updatedAt, verifiedAt } }.
  /// A customer's correction always outranks an inference.
  factsJson   String @default("{}") @db.Text
  /// Facts that used to be true ("Previously offered window tinting"), kept
  /// apart from current facts: [{ field, text, until, source }].
  historyJson String @default("[]") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DecisionCategory {
  NEEDS_ATTENTION
  GROWTH
  CREATIVE
  BUDGET
  AUDIENCE
  RETARGETING
  WEBSITE
  TESTING
}

enum DecisionStatus {
  /// Waiting for the business to decide.
  PENDING
  /// Carried out, by a person approving it or by MAIRO within its limits.
  APPLIED
  REJECTED
  /// Set aside without an answer. Kept out of the history.
  IGNORED
  /// The situation it described has passed.
  EXPIRED
  /// Approved, but the network refused. Nothing was left half-changed.
  FAILED
}

enum DecisionConfidence {
  HIGH
  MEDIUM
  EARLY
}

enum DecisionRisk {
  LOW
  MEDIUM
  HIGH
}

/// One thing MAIRO noticed and what it would do about it.
///
/// Written only from the account's own figures (src/lib/decisions/rules.ts),
/// and only when there is something worth doing — an account with nothing to
/// change has no decisions, not filler. Network-agnostic: the changes name a
/// platform and an adapter carries them out, so a network added later uses
/// the same cards, approvals and history.
model MairoDecision {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  mairoCampaignId String?
  platform        AdPlatform?

  /// The rule that produced it, e.g. "pause-ad", "shift-budget".
  kind     String
  category DecisionCategory
  urgent   Boolean          @default(false)

  title           String
  /// What MAIRO noticed, in plain words.
  noticed         String @db.Text
  /// The same, with the advertising terms, for Advanced mode.
  noticedAdvanced String @db.Text
  whyItMatters    String @db.Text
  recommendation  String @db.Text
  /// What could change, without promising a number.
  impact          String @db.Text

  risk       DecisionRisk
  confidence DecisionConfidence

  /// The figures behind it: [{ label, value, metric? }].
  evidenceJson     String  @db.Text
  /// What would change: see DecisionChange in src/lib/decisions/types.ts.
  changesJson      String  @db.Text
  /// The automation action it counts as, for the guardrails.
  automationAction String?

  status    DecisionStatus @default(PENDING)
  /// Same situation, same key: re-running the rules updates rather than duplicates.
  dedupeKey String
  /// "daily" from the scheduled check, "assistant" from a One-Click Fix.
  source    String         @default("daily")

  /// What was actually done, with the before and after of each change.
  resultJson  String?   @db.Text
  decidedAt   DateTime?
  /// Set while an approval is being carried out, so a second approval (a
  /// double click, two tabs, MAIRO acting at the same moment) can't send the
  /// same change to Meta twice. A lease: an approval that crashed frees it
  /// after two minutes.
  applyingAt  DateTime?
  decidedById String?
  /// True when MAIRO carried it out itself under AI Assist or Full Autopilot.
  automatic   Boolean   @default(false)

  /// What happened after it was carried out, once enough time has passed
  /// to compare (IMPROVED, WORSENED, INCONCLUSIVE, NOT_MEASURABLE). Describes
  /// what followed the change — never a claim that the change caused it.
  verdict     String?
  verdictNote String?   @db.Text
  /// The before and after figures behind the verdict.
  verdictJson String?   @db.Text
  verdictAt   DateTime?
  /// The Performance Coach finding that proposed it, if one did.
  findingId   String?
  /// The daily team review that last produced or re-confirmed this
  /// recommendation — its steps (results read, proposal, limit check) are
  /// how the AI Team screen shows who contributed. Null for one made outside
  /// a review (an assistant proposal, or one older than this column).
  reviewRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status, createdAt])
}

/// Everything MAIRO did to an account, with the reason. Append-only.
///
/// The audit trail for "what did the AI do with my money?". A row is written
/// only after a network accepted the change, so nothing here describes a
/// change that didn't happen.
model MairoActivity {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  mairoCampaignId String?
  decisionId      String?

  /// "Reduced a budget", "Paused an ad"…
  action      String
  /// One sentence of what changed.
  summary     String  @db.Text
  reason      String  @db.Text
  before      String?
  after       String?
  /// True when MAIRO did it on its own; false when a person approved it.
  automatic   Boolean @default(false)
  actorUserId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// --- Mairo Intelligence -------------------------------------------------------
//
// One normalized record per thing Mairo noticed, shared by Business Health,
// the Opportunity Radar, the Morning Brief, "Mairo found this before you did"
// and the Campaign Timeline. Written by the same daily look that writes Mairo
// Decisions (src/lib/intelligence/run.ts); a finding that comes with a change
// Mairo can make links to its MairoDecision.

enum BriefFrequency {
  DAILY
  WEEKLY
}

enum InsightCategory {
  PERFORMANCE
  CREATIVE
  AUDIENCE
  BUDGET
  WEBSITE
  TRACKING
  PLATFORM
}

/// How much it matters. Most findings are not urgent, and are not labelled so.
enum InsightSeverity {
  INFO
  OPPORTUNITY
  ATTENTION
  URGENT
}

enum InsightStatus {
  /// Still true on the last look.
  OPEN
  /// No longer seen on a later look.
  RESOLVED
  /// The business said it didn't want to hear about it.
  DISMISSED
}

model MairoInsight {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  mairoCampaignId String?
  campaignName    String?
  platform        AdPlatform?

  /// The detector that found it, e.g. "creative-fatigue", "cpa-rising".
  type       String
  category   InsightCategory
  severity   InsightSeverity
  confidence DecisionConfidence

  metric        String?
  previousValue String?
  currentValue  String?

  title            String
  happened         String  @db.Text
  happenedAdvanced String  @db.Text
  whyItMatters     String  @db.Text
  recommendation   String  @db.Text
  /// Why this recommendation, rather than another.
  reason           String  @db.Text
  /// What changes if the business approves it.
  ifApproved       String  @db.Text
  evidenceJson     String  @db.Text
  /// Days, impressions, clicks and results the finding rests on.
  basedOnJson      String  @db.Text
  /// What doing something about it looks like, as a normalized action.
  actionType       String?
  actionLabel      String?
  actionHref       String?
  /// Opportunity Radar area, when it is one.
  radarArea        String?
  /// Shown on "Mairo found this before you did".
  earlyWarning     Boolean @default(false)

  /// The Mairo Decision carrying the change, when there is one.
  decisionDedupeKey String?

  status      InsightStatus @default(OPEN)
  dedupeKey   String
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, status])
  @@index([mairoCampaignId])
}

/// The last computed Business Health, Opportunity Radar and Morning Brief,
/// so the dashboard reads them without asking Meta again.
model IntelligenceReport {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportJson     String       @db.Text
  computedAt     DateTime
  updatedAt      DateTime     @updatedAt
}

/// What a sale costs the business beyond advertising, for Profit First.
/// Everything is optional: missing numbers mean profit is shown as unknown,
/// never guessed.
model ProfitSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Gross margin on what's sold, 0–100. Wins over price and cost when set.
  averageMarginPercent   Float?
  sellingPriceCents      Int?
  productCostCents       Int?
  averageOrderValueCents Int?
  /// Per order.
  shippingCostCents      Int    @default(0)
  paymentFeePercent      Float  @default(2.9)
  paymentFeeFixedCents   Int    @default(30)
  /// Rent, software, wages — spread evenly across the month.
  otherMonthlyCostsCents Int    @default(0)

  updatedAt DateTime @updatedAt
}

// --- Weekly Report --------------------------------------------------------------
//
// A summary layer over what Mairo already knows: the week's figures from the
// ad networks, the Insights, Business Health, Mairo Activity and Decisions.
// The report is written once, when it's generated, so history reads the way
// the week actually looked (src/lib/reports/weekly.ts).

model WeeklyReport {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// First and last day covered, inclusive (UTC dates).
  weekStart   DateTime
  weekEnd     DateTime
  /// Everything the report shows, as it was on the day it was written.
  dataJson    String   @db.Text
  generatedAt DateTime @default(now())

  /// Client reports an agency shares: approved first, then a link exists.
  approvedAt DateTime?
  shareToken String?   @unique

  @@unique([organizationId, weekStart])
  @@index([organizationId, weekStart])
}

model ReportSettings {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  weeklyEnabled  Boolean @default(true)
  /// 0 Sunday … 6 Saturday, in the business's own time zone.
  deliveryDay    Int     @default(1)
  /// "simple", "advanced" or "profit".
  preferredMode  String  @default("simple")
  /// A card in the notification centre when it's ready.
  inApp          Boolean @default(true)
  onlyWhenActive Boolean @default(true)

  /// Agency workspaces: how their client reports are branded and shared.
  brandName    String?
  brandLogoUrl String?
  /// Leave Mairo's internal notes (what it learned, its approval trail) out of shared reports.
  hideInternal Boolean @default(true)
  /// Create a share link as soon as a client report is approved. Never sends anything.
  autoApprove  Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Mairo Learning Memory: what Mairo has learned about this business from its
/// own results, strong enough to act on. Weak signals are shown in the report
/// and never saved.
model MairoLearning {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// Same lesson, same key, so a finding confirmed again strengthens rather than duplicates.
  key            String
  category       String
  statement      String             @db.Text
  detail         String             @db.Text
  evidenceJson   String             @db.Text
  confidence     DecisionConfidence
  timesSeen      Int                @default(1)
  firstLearnedAt DateTime           @default(now())
  lastSeenAt     DateTime           @default(now())
  sourceReportId String?
  /// The business can switch a lesson off.
  active         Boolean            @default(true)
  /// The mission goal this was learned under (e.g. GET_BOOKINGS), when known.
  goal           String?
  /// How many ads, campaigns or posts the comparison rested on.
  sampleSize     Int?

  @@unique([organizationId, key])
  @@index([organizationId, active])
}

// --- Free plan: review, revise, approve --------------------------------

enum StrategyPlanStatus {
  DRAFT
  REVISING
  APPROVED
}

/// The advertising plan MAIRO writes for free after business setup.
///
/// The business reviews it, asks MAIRO to change it or edits it by hand, and
/// approves it before choosing a subscription. After payment it becomes the
/// first campaign. Changing it before payment returns it to DRAFT; once the
/// subscription is active it is locked and the campaign is built from the
/// approved snapshot.
model StrategyPlan {
  id                   String             @id @default(cuid())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String             @unique
  status               StrategyPlanStatus @default(DRAFT)
  /// 0 is the original plan; each revision adds one.
  version              Int                @default(0)
  /// The plan as it stands now (StrategyContent JSON).
  planJson             String             @db.Text
  approvedAt           DateTime?
  approvedVersion      Int?
  /// Exactly what was approved. Never edited afterwards.
  approvedSnapshotJson String?            @db.Text
  /// When the subscription was confirmed and the plan locked.
  activatedAt          DateTime?
  /// The Create draft prefilled from the approved plan.
  campaignDraftId      String?
  /// The campaign built from it.
  campaignId           String?
  launchedAt           DateTime?
  /// When the post-launch welcome was dismissed.
  welcomedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  revisions StrategyPlanRevision[]
}

model StrategyPlanRevision {
  id          String       @id @default(cuid())
  plan        StrategyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      String
  version     Int
  /// original | ai | edit | suggestion | undo
  kind        String
  /// What the business asked for, in their words (AI revisions).
  request     String?      @db.Text
  summary     String
  /// PlanChange[] JSON: section, previous, updated, reason.
  changesJson String       @db.Text
  /// The whole plan after this revision.
  planJson    String       @db.Text
  /// "you" or "mairo".
  requestedBy String
  createdAt   DateTime     @default(now())

  @@unique([planId, version])
}

/// The business's MAIRO mission: what it wants to achieve, and the plan MAIRO
/// built for it. One is ACTIVE at a time; a change MAIRO suggests (or the
/// business asks for) waits as PROPOSED until approved.
model MarketingMission {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// PROPOSED, ACTIVE or ARCHIVED.
  status          String    @default("PROPOSED")
  /// One of the goals in lib/mission/goals.ts, e.g. GET_BOOKINGS.
  primaryGoal     String
  secondaryGoal   String?
  /// What the business said, in its own words.
  request         String    @default("") @db.Text
  /// "Get More Appointments" — shown as the mission.
  title           String
  /// The plan (JSON): strategy, why, focus, tactics, ad concepts, timeline.
  planJson        String    @db.Text
  aiUsed          Boolean   @default(false)
  /// The Create draft MAIRO prefilled from this plan.
  campaignDraftId String?
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}

/// Something the business told MAIRO: a promotion this week, a product that
/// sold out, a fact about the business. MAIRO plans around it.
model MissionNote {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// PROMOTION, UNAVAILABLE, LAUNCH or INFO.
  kind        String
  text        String    @db.Text
  /// What MAIRO understood (JSON): offer, item, dates…
  detailsJson String    @default("{}") @db.Text
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([organizationId, active])
}

// --- Platform Intelligence (Meta first) --------------------------------------
//
// Keeps MAIRO aligned with changes to the ad platforms it runs on. Every table
// carries `platform` so TikTok, Google Ads and others can reuse it; only Meta
// is implemented (src/lib/meta-intelligence). External content is untrusted:
// nothing here changes code or a customer's live campaign on its own.

/// A source MAIRO monitors. OFFICIAL outranks TRUSTED; nothing changes product
/// behaviour on an UNVERIFIED source alone.
model PlatformSource {
  id            String    @id @default(cuid())
  platform      String    @default("META")
  key           String    @unique
  name          String
  url           String
  /// CHANGELOG, VERSIONS, DOCS, HELP_CENTER, ANNOUNCEMENTS
  kind          String
  /// OFFICIAL, TRUSTED or UNVERIFIED.
  authority     String    @default("OFFICIAL")
  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  lastChangedAt DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  snapshots PlatformSourceSnapshot[]
  updates   PlatformUpdate[]
}

/// What a source said at one moment. Kept, never overwritten, so a change can
/// be traced to the exact text before and after.
model PlatformSourceSnapshot {
  id        String         @id @default(cuid())
  source    PlatformSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId  String
  hash      String
  /// Normalised text (capped), as blocks separated by blank lines.
  text      String         @db.Text
  fetchedAt DateTime       @default(now())

  @@index([sourceId, fetchedAt])
}

/// One detected change ("Meta Update"), carried through the safe update
/// pipeline: DETECTED → ANALYZED → PROPOSED → DEVELOPMENT → AUTOMATED_TESTING
/// → SANDBOX_TESTING → APPROVED → PRODUCTION (or DISMISSED).
model PlatformUpdate {
  id            String          @id @default(cuid())
  platform      String          @default("META")
  source        PlatformSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceId      String?
  /// Same change, same key: a re-run never files it twice.
  dedupeKey     String          @unique
  title         String
  /// The text that changed (untrusted, shown as plain text only).
  excerpt       String          @db.Text
  sourceUrl     String?
  /// NEW_FEATURE, DEPRECATION, API_VERSION_RELEASE, PERMISSION_CHANGE, … (see platform-intelligence/types.ts)
  changeType    String
  /// Area: campaign-creation, budget, publishing, permissions, billing, optimization, targeting, placements, creative, measurement, ai, api-version, knowledge
  areas         String[]        @default([])
  urgency       String          @default("LOW")
  risk          String          @default("UNKNOWN")
  compatibility String          @default("NOT_APPLICABLE")
  status        String          @default("DETECTED")
  /// The AI (or rule) interpretation, as JSON.
  analysisJson  String?         @db.Text
  analyzedBy    String?
  /// A structured, validated proposal: registry/knowledge changes only (JSON).
  proposalJson  String?         @db.Text
  /// Feature in the registry this concerns, when known.
  featureKey    String?
  /// Who moved it last, and every move (JSON array), for the audit trail.
  historyJson   String          @default("[]") @db.Text
  detectedAt    DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([platform, status])
  @@index([platform, urgency])
}

/// The Meta Feature Registry (platform = META): every capability MAIRO relies
/// on or is evaluating. MAIRO's source of truth for what Meta offers.
model PlatformFeature {
  id                 String    @id @default(cuid())
  platform           String    @default("META")
  featureKey         String
  name               String
  category           String
  description        String    @db.Text
  apiVersion         String?
  objectives         String[]  @default([])
  optimizationGoals  String[]  @default([])
  placements         String[]  @default([])
  creativeFormats    String[]  @default([])
  permissions        String[]  @default([])
  accountType        String?
  /// GA, LIMITED, BETA, ALPHA, UNKNOWN
  availability       String    @default("UNKNOWN")
  betaStatus         String?
  regionRestrictions String[]  @default([])
  deprecated         Boolean   @default(false)
  deprecationDate    DateTime?
  replacementKey     String?
  lastVerifiedAt     DateTime?
  sourceUrl          String?
  /// SUPPORTED, PARTIALLY_SUPPORTED, TESTING, NOT_SUPPORTED, DEPRECATED, NOT_APPLICABLE
  mairoSupport       String    @default("NOT_SUPPORTED")
  /// Where MAIRO uses it (JSON): systems and code paths.
  mairoMapping       String    @default("{}") @db.Text
  /// LOW, MEDIUM, HIGH
  breakingRisk       String    @default("LOW")
  /// Goal families it can serve (sales, leads, bookings…). Goal first.
  goalFit            String[]  @default([])
  /// It's one of Meta's AI/automation (Advantage+) tools.
  aiCapability       Boolean   @default(false)
  notes              String?   @db.Text
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([platform, featureKey])
}

/// Versioned knowledge. A change writes a new version and supersedes the old;
/// nothing is overwritten, so a problem can be traced to what MAIRO believed.
model PlatformKnowledge {
  id           String    @id @default(cuid())
  platform     String    @default("META")
  /// feature, api-behavior, objective, optimization, placement, creative-spec, measurement, permission, rate-limit, deprecation, limitation, strategy
  topic        String
  key          String
  version      Int
  dataJson     String    @db.Text
  summary      String    @db.Text
  source       String
  /// HIGH, MEDIUM, LOW
  confidence   String    @default("MEDIUM")
  /// VALIDATED knowledge feeds MAIRO's reasoning; PROPOSED waits for the pipeline.
  state        String    @default("VALIDATED")
  verifiedAt   DateTime?
  changeNote   String?   @db.Text
  updateId     String?
  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([platform, topic, key, version])
  @@index([platform, topic, key])
}

/// A feature flag for a platform capability: OFF, INTERNAL, SELECTED, ALL_ELIGIBLE.
model PlatformFeatureFlag {
  id             String   @id @default(cuid())
  platform       String   @default("META")
  key            String   @unique
  featureKey     String?
  description    String   @db.Text
  stage          String   @default("OFF")
  internalOrgIds String[] @default([])
  selectedOrgIds String[] @default([])
  updatedBy      String?
  historyJson    String   @default("[]") @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// API versions: what production runs, what's available, what's retiring.
model PlatformApiVersion {
  id              String    @id @default(cuid())
  platform        String    @default("META")
  version         String
  releasedAt      DateTime?
  /// When the platform retires it, from an official source or entered by an admin.
  retiresAt       DateTime?
  retiresSource   String?
  /// AVAILABLE, PRODUCTION, CANDIDATE, DEPRECATED, RETIRED
  status          String    @default("AVAILABLE")
  /// NOT_STARTED, TESTING, PASSED, MIGRATED
  migrationStatus String    @default("NOT_STARTED")
  breakingNotes   String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([platform, version])
}

/// Platform API errors, grouped by signature. An unfamiliar error spreading
/// across accounts is often the first sign the platform changed.
model PlatformApiError {
  id          String    @id @default(cuid())
  platform    String    @default("META")
  signature   String    @unique
  code        Int?
  subcode     Int?
  message     String    @db.Text
  endpoint    String
  method      String
  apiVersion  String
  requestType String
  count       Int       @default(1)
  /// Hashed account keys (never tokens), capped.
  accountKeys String[]  @default([])
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())
  flagged     Boolean   @default(false)
  flaggedAt   DateTime?
  updateId    String?

  @@index([platform, lastAt])
}

/// A run of the platform integration tests: CONTRACT (stubbed), SANDBOX (a
/// test ad account) or MANUAL (an admin's recorded test-account check).
model PlatformTestRun {
  id             String    @id @default(cuid())
  platform       String    @default("META")
  mode           String
  apiVersion     String
  passed         Int       @default(0)
  failed         Int       @default(0)
  criticalFailed Int       @default(0)
  resultsJson    String    @db.Text
  updateId       String?
  ranBy          String?
  notes          String?   @db.Text
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([platform, startedAt])
}

/// The MAIRO Meta Update log: what Meta changed and what MAIRO changed because of it.
model PlatformReleaseLog {
  id           String   @id @default(cuid())
  platform     String   @default("META")
  version      String
  metaChanges  String[] @default([])
  mairoChanges String[] @default([])
  updateIds    String[] @default([])
  createdBy    String?
  createdAt    DateTime @default(now())

  @@unique([platform, version])
}

/// What a business's own ad account can use (country, currency, capabilities,
/// granted permissions). Features are never shown as available without it.
model PlatformAccountCapability {
  id             String       @id @default(cuid())
  platform       String       @default("META")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  adAccountId    String?
  country        String?
  currency       String?
  accountStatus  Int?
  capabilities   String[]     @default([])
  permissions    String[]     @default([])
  checkedAt      DateTime     @default(now())
  error          String?      @db.Text

  @@unique([platform, organizationId])
}

/// A business saying yes to MAIRO trying a validated platform capability.
model PlatformFeatureOptIn {
  id             String       @id @default(cuid())
  platform       String       @default("META")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  featureKey     String
  /// APPROVED or DECLINED
  status         String
  decidedAt      DateTime     @default(now())

  @@unique([platform, organizationId, featureKey])
}

/// Internal notifications for MAIRO administrators (AIOS).
model PlatformAdminAlert {
  id        String    @id @default(cuid())
  platform  String    @default("META")
  dedupeKey String    @unique
  /// CRITICAL, HIGH, MEDIUM, LOW
  severity  String
  title     String
  body      String    @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([platform, readAt])
}

/// What the business tells MAIRO about MAIRO: the "is MAIRO making
/// advertising easier?" pulse, problems, ideas, what's confusing, and why
/// they're leaving. Read by the MAIRO team in AIOS; never shown to anyone else.
enum FeedbackKind {
  PULSE
  PROBLEM
  IDEA
  CONFUSING
  CANCELLATION
}

enum FeedbackEasier {
  YES
  SOMEWHAT
  NO
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model CustomerFeedback {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  userId         String?
  kind           FeedbackKind
  /// The pulse answer: is MAIRO making advertising easier?
  easier         FeedbackEasier?
  text           String?         @db.Text
  /// The screen it was sent from.
  page           String?
  status         FeedbackStatus  @default(OPEN)
  /// The MAIRO team's own note, never shown to the business.
  internalNote   String?         @db.Text
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

enum SupportChannel {
  CALL
  EMAIL
  CHAT
  MEETING
  NOTE
}

/// A record of the MAIRO team talking to a business — internal only.
model SupportNote {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  authorId       String?
  channel        SupportChannel @default(NOTE)
  text           String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
}

/// The eight specialties of the MAIRO AI Team. Not eight running processes:
/// each is a set of MAIRO's existing services, and a run is one of them
/// doing a piece of work for one business.
enum AgentRole {
  STRATEGIST
  AUDIENCE
  CREATIVE
  ARCHITECT
  OPTIMIZER
  GUARDIAN
  ANALYST
  GROWTH
}

enum AgentRunStatus {
  RUNNING
  /// Finished and produced something: a plan, a change, a report.
  DONE
  /// Finished and found nothing that needed doing — said so, not hidden.
  NOTHING
  FAILED
}

/// One piece of work by one specialty, recorded by the service that did it.
/// The AI Team screen, the activity feed and the Daily Brief read only these
/// (and the decisions they link to) — nothing on them is made up.
model AgentRun {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  agent          AgentRole
  /// What kind of work: "daily-review", "spend-check", "weekly-report"…
  task           String
  status         AgentRunStatus @default(RUNNING)
  /// One sentence the customer reads: what it did or found.
  summary        String?        @db.Text
  /// Why, and the figures behind it, for "See details".
  detail         String?        @db.Text
  /// Where to see the result.
  href           String?
  /// The coordinating run this was a step of (the daily team review).
  parentId       String?
  /// A decision this run proposed or checked.
  decisionId     String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([organizationId, startedAt])
  @@index([organizationId, agent, startedAt])
  @@index([status, startedAt])
}

/// What the Performance Coach investigates.
enum CoachCategory {
  CREATIVE
  AUDIENCE
  CONVERSION
  TRACKING
  LEAD_QUALITY
  FOLLOW_UP
  SALES
  BUDGET
  OPPORTUNITY
}

/// How strong the evidence is — words, never a percentage.
enum CoachConfidence {
  /// Direct records, or enough data on both sides of a comparison.
  STRONG
  /// Enough to act on, not enough to be sure.
  SOME
  /// A first sign, said as one.
  EARLY
}

enum CoachFindingStatus {
  OPEN
  /// The business accepted the plan.
  APPROVED
  DISMISSED
  /// No longer seen on a later review, or the plan is done.
  RESOLVED
}

/// One thing the Performance Coach found: what it observed (with the numbers),
/// the possible explanations (kept apart from what was observed), what it
/// recommends, how sure it is and what it can't see, and the improvement plan.
/// Also the optimization history: what was approved, done, and what followed.
model CoachFinding {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  mairoCampaignId String?
  campaignName    String?

  /// The situation, so a later review updates this row instead of repeating it.
  key        String
  category   CoachCategory
  /// ATTENTION, OPPORTUNITY or WATCH.
  severity   String
  confidence CoachConfidence
  /// Higher first, as the investigation ranked it, so the list keeps its order.
  priority   Int             @default(50)

  title          String
  /// The plain-language sentence for someone with no advertising knowledge.
  plain          String @db.Text
  /// What MAIRO noticed: observed, measured.
  noticed        String @db.Text
  /// Possible explanations: [{ text, basis: "evidence" | "possibility" }].
  explanationsJson String @db.Text
  recommendation String @db.Text
  /// Other recommendations, for "another recommendation".
  alternativesJson String @db.Text
  alternativeIndex Int    @default(0)
  /// The numbers behind it: [{ label, value, detail? }].
  evidenceJson   String @db.Text
  limitations    String @db.Text
  /// What MAIRO can't see that would settle it.
  missingJson    String @db.Text
  /// The improvement plan: steps with priority, risk, approval, verification and status.
  stepsJson      String @db.Text
  /// The specialists that worked on it.
  agentsJson     String @db.Text
  /// The figure that would show the plan worked: { metric, value, betterWhen, unit }.
  measureJson    String? @db.Text

  /// A change on Meta it proposed, through Mairo Decisions' approval path.
  decisionId String?

  status     CoachFindingStatus @default(OPEN)
  /// HELPFUL or NOT_HELPFUL, if the business said.
  feedback   String?
  decidedAt  DateTime?
  resolvedAt DateTime?
  /// When to look again at an approved plan, and what was seen.
  checkAfter  DateTime?
  verdict     String?
  verdictNote String?   @db.Text
  verdictAt   DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, key])
}
