# Mairo configuration.
# Copy this file to .env in the same folder, then fill in your key.
# Never commit .env — it is ignored by git.

# Required: your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The model Mairo thinks with. Change it here, no code edits needed.
OPENAI_MODEL=gpt-4o-mini

# Optional: speech models. Leave as they are unless you know you want others.
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: point Mairo at an OpenAI-compatible endpoint instead.
# OPENAI_BASE_URL=

# Optional: wake word. Install pvporcupine, then get a free access key from
# https://console.picovoice.ai and paste it here. A custom "Hey Mairo" keyword
# file is trained free on that console; point PICOVOICE_KEYWORD_FILE at it.
# Without a keyword file Mairo listens for the built-in word "computer".
# PICOVOICE_ACCESS_KEY=
# PICOVOICE_KEYWORD_FILE=

# Optional: what Mairo should call you before it learns your name.
# MAIRO_USER_NAME=

# Optional: store Mairo's data somewhere other than %APPDATA%\Mairo
# MAIRO_HOME=

